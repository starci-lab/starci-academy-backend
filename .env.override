# PostgreSQL primary — envConfig.databases.postgresql.primary
POSTGRESQL_PRIMARY_HOST=localhost
POSTGRESQL_PRIMARY_PORT=5433
POSTGRESQL_PRIMARY_USERNAME=postgres
POSTGRESQL_PRIMARY_PASSWORD=Cuong123_A
POSTGRESQL_PRIMARY_DATABASE=starci-academy

# Redis — envConfig.redis (BullMQ, Throttler, Adapter, Cache)
REDIS_BULLMQ_HOST=127.0.0.1
REDIS_BULLMQ_PORT=6380
REDIS_BULLMQ_PASSWORD=Cuong123_A
REDIS_BULLMQ_USE_CLUSTER=false
REDIS_THROTTLER_HOST=127.0.0.1
REDIS_THROTTLER_PORT=6380
REDIS_THROTTLER_PASSWORD=Cuong123_A
REDIS_THROTTLER_USE_CLUSTER=false
REDIS_ADAPTER_HOST=127.0.0.1
REDIS_ADAPTER_PORT=6380
REDIS_ADAPTER_PASSWORD=Cuong123_A
REDIS_ADAPTER_USE_CLUSTER=false
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6380
REDIS_CACHE_PASSWORD=Cuong123_A
REDIS_CACHE_USE_CLUSTER=false

# Seed/sync scope is configured in .mount/config/seed.yaml (not env).

# CDN upload targets
# - true  => upload to Minio + DigitalOcean Spaces
# - false => upload to Minio only (local dev)
SYNC_CDN_UPLOAD_TO_DIGITAL_OCEAN=false

# Tắt ForkTsChecker khi build (dev seed) để tránh OOM do lỗi type pre-existing toàn repo
DISABLE_FORK_TS_CHECKER=true

# AI Balancer health-check cadence (default 1m). Set short for quick dev iteration.
AI_BALANCER_HEALTH_CHECK_INTERVAL_MS=10s

# Lesson RAG index — default OFF (costs boot time on every reseed). Enable locally
# to test the content-AI chat retrieval path (build persistent `lesson_rag` Qdrant
# collection over every lesson body + sandbox code at init).
LESSON_RAG_INDEX_ENABLED=true

# Elasticsearch — apply explicit index mappings (required for SCHEMA V2 challenges/contents)
ELASTICSEARCH_APPLY_INDEX_MAPPINGS=true

# Note: "DROP + re-create ALL ES indices" is now controlled by `reIndex` in
# .mount/config/seed.yaml (not env).

# Synchronizer reconcile — mỗi lần sync sẽ diff CDN (Minio+DigitalOcean) & Elasticsearch
# với DB rồi log số orphan. Bật cờ này (=true) thì XOÁ luôn orphan; mặc định false = chỉ log diff.
SYNC_PRUNE_ORPHANS=false
# Van an toàn: nếu tỉ lệ orphan / tổng vượt ngưỡng này thì BỎ QUA xoá (đề phòng DB rỗng/trỏ sai
# làm quét sạch store). 0.5 = 50%.
SYNC_PRUNE_MAX_RATIO=0.5

# CSRF — HMAC secret for signing double-submit CSRF tokens. MUST be a long random
# string in production (e.g. `openssl rand -hex 32`); the code default is insecure.
CSRF_SECRET=dev-insecure-csrf-secret-change-me

# Cookie domain — scope for the JS-readable csrf_token cookie. Set to the parent
# domain in production so the SPA (academy.starci.org) can read the cookie that
# the API (api.academy.starci.org) issues. Leave EMPTY in local dev = host-only.
# Production value: .academy.starci.org
COOKIE_DOMAIN=

# Captcha (Cloudflare Turnstile). Disabled in dev so local login isn't blocked.
# In production set CAPTCHA_ENABLED=true and TURNSTILE_SECRET to the real secret key.
CAPTCHA_ENABLED=false
TURNSTILE_SECRET=

# Judge0 (coding-practice sandbox). Local Docker Desktop runs cgroup v2, which
# Judge0's isolate sandbox can't use (every run => status 13 Internal Error), so
# point at the self-hosted Judge0 on the VPS (Ubuntu 20.04, cgroup v1) instead.
# Verified end-to-end: python "hello" => status 3 Accepted.
JUDGE0_BASE_URL=https://judge0.academy.starci.org

# Dev-only artificial API latency so the frontend shows its loading/skeleton states
# (ResponseDelayInterceptor). Forced OFF in production regardless of this flag.
# Turn off by setting =false (or removing). Tune the latency with API_RESPONSE_DELAY_MS.
API_RESPONSE_DELAY_ENABLE=false
API_RESPONSE_DELAY_MS=5000

# Seed-content `data` repo was moved to the starci-lab org (module/code repos stay
# under GITHUB_ORGANIZATION=StarCi-Academy). GitHub redirects the old URL, but point
# at the new owner explicitly. Set the SAME on prod.
DATA_GIT_OWNER=starci-lab

# GitHub OAuth login client id (NOT secret — public, sent in the authorize URL).
# Local = the "Test" OAuth app. Prod uses the "StarCi Academy" app id
# (Ov23litbAC9Wd06iTeQH) set as a deploy env/Actions var, not here.
# The client SECRET + the org PAT live in mount files (.mount/terraform/github-*.key),
# never in this file.
GITHUB_CLIENT_ID=Ov23li5w0Z4OaI4lyjgf
