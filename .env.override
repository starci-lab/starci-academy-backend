REDIS_CACHE_PASSWORD=Cuong123_A
REDIS_CACHE_USE_CLUSTER=false

# Init seed/sync scope — envConfig.init (override via INIT_* below)
ENABLE_INIT_SEEDERS=true
ENABLE_INIT_SYNCHRONIZERS=true
INIT_SEEDERS_COURSES_ENABLED=true
INIT_SEEDERS_COURSES_MODULES_FULLSTACK_ENABLED=false
INIT_SEEDERS_COURSES_MODULES_FULLSTACK=true
INIT_SEEDERS_COURSES_MILESTONES_FULLSTACK_ENABLED=false
INIT_SEEDERS_COURSES_MODULES_SYSTEM_DESIGN_ENABLED=false
INIT_SEEDERS_COURSES_MODULES_SYSTEM_DESIGN_INDEXES=off
INIT_SEEDERS_COURSES_MILESTONES_SYSTEM_DESIGN_ENABLED=false
INIT_SEEDERS_COURSES_QUIZ_ENABLED=false
INIT_SEEDERS_COURSES_QUIZ_LINK_CONTENTS=false
INIT_SEEDERS_CODING_PROBLEMS=true
INIT_SEEDERS_AI_MODELS=true
INIT_SEEDERS_SUBSCRIPTIONS=false
INIT_SEEDERS_CV=false
INIT_SEEDERS_FOUNDATIONS=false
INIT_SEEDERS_HEADHUNTING=false
INIT_SYNCHRONIZERS_COURSES_MODULES_FULLSTACK_CDN_INDEXES=off
INIT_SYNCHRONIZERS_COURSES_MODULES_FULLSTACK_CDN_ENABLED=true
INIT_SYNCHRONIZERS_COURSES_MODULES_FULLSTACK_ELASTICSEARCH_INDEXES=off
INIT_SYNCHRONIZERS_COURSES_MODULES_FULLSTACK_ELASTICSEARCH_ENABLED=true
INIT_SYNCHRONIZERS_COURSES_MILESTONES_FULLSTACK_CDN_ENABLED=false
INIT_SYNCHRONIZERS_COURSES_MILESTONES_FULLSTACK_ELASTICSEARCH_ENABLED=false
INIT_SYNCHRONIZERS_COURSES_MODULES_SYSTEM_DESIGN_CDN_INDEXES=off
INIT_SYNCHRONIZERS_COURSES_MODULES_SYSTEM_DESIGN_CDN_ENABLED=true
INIT_SYNCHRONIZERS_COURSES_MODULES_SYSTEM_DESIGN_ELASTICSEARCH_INDEXES=off
INIT_SYNCHRONIZERS_COURSES_MODULES_SYSTEM_DESIGN_ELASTICSEARCH_ENABLED=true
INIT_SYNCHRONIZERS_COURSES_MILESTONES_SYSTEM_DESIGN_CDN_ENABLED=false
INIT_SYNCHRONIZERS_COURSES_MILESTONES_SYSTEM_DESIGN_ELASTICSEARCH_ENABLED=false
INIT_SYNCHRONIZERS_CV=false
INIT_SYNCHRONIZERS_FOUNDATIONS=false
INIT_SYNCHRONIZERS_HEADHUNTING=false

# CDN upload targets
# - true  => upload to Minio + DigitalOcean Spaces
# - false => upload to Minio only (local dev)
SYNC_CDN_UPLOAD_TO_DIGITAL_OCEAN=false

# Tắt ForkTsChecker khi build (dev seed) để tránh OOM do lỗi type pre-existing toàn repo
DISABLE_FORK_TS_CHECKER=true

# AI Balancer health-check cadence (default 1m). Set short for quick dev iteration.
AI_BALANCER_HEALTH_CHECK_INTERVAL_MS=10s

# Elasticsearch — apply explicit index mappings (required for SCHEMA V2 challenges/contents)
ELASTICSEARCH_APPLY_INDEX_MAPPINGS=true

# Elasticsearch — DROP + re-create ALL entity indices from config mapping at boot, then resync.
# Destructive: wipes ES. Turn ON for one boot to rebuild clean indices, then turn OFF.
ELASTICSEARCH_RESET_INDICES=true

# Synchronizer reconcile — mỗi lần sync sẽ diff CDN (Minio+DigitalOcean) & Elasticsearch
# với DB rồi log số orphan. Bật cờ này (=true) thì XOÁ luôn orphan; mặc định false = chỉ log diff.
SYNC_PRUNE_ORPHANS=false
# Van an toàn: nếu tỉ lệ orphan / tổng vượt ngưỡng này thì BỎ QUA xoá (đề phòng DB rỗng/trỏ sai
# làm quét sạch store). 0.5 = 50%.
SYNC_PRUNE_MAX_RATIO=0.5

# CSRF — HMAC secret for signing double-submit CSRF tokens. MUST be a long random
# string in production (e.g. `openssl rand -hex 32`); the code default is insecure.
CSRF_SECRET=dev-insecure-csrf-secret-change-me

# Captcha (Cloudflare Turnstile). Disabled in dev so local login isn't blocked.
# In production set CAPTCHA_ENABLED=true and TURNSTILE_SECRET to the real secret key.
CAPTCHA_ENABLED=false
TURNSTILE_SECRET=
