EXECUTOR_STREAMS_MONGO_DB_CHANGE_STREAM_TIMEOUT=5m
# Payment reconcile poll. true = webhook + fallback poll (prod-safe). Set false
# ONLY for local webhook-isolation testing — never commit false (disables the
# prod safety net that finalizes paid transactions when a webhook is missed).
API_TRANSACTION_RECONCILE_ENABLED=true

# SePay Payment Gateway — LIVE creds (secret in .mount/terraform/sepay-api-key.key on each host)
API_SEPAY_ENV=production
API_SEPAY_MERCHANT_ID=SP-LIVE-CN948B45
EXECUTOR_OPERATION_RECONCILE_BALANCE_INTERVAL=30s
DEXES_TURBOS_OPEN_POSITION_SLIPPAGE=0.2
EXECUTOR_OPERATION_OPEN_POSITION_STIMULATE=false
EXECUTOR_OPERATION_RECONCILE_BALANCE_STIMULATE=false
EXECUTOR_OPERATION_CLOSE_POSITION_STIMULATE=false
EXECUTOR_OPERATION_CLOSE_POSITION_STIMULATE_CONFIRM=false
EXECUTOR_OPERATION_CLOSE_POSITION_SETTLE_ENABLED=true
EXECUTOR_OPERATION_TRANSFER_FEES_STIMULATE=false
EXECUTOR_OPERATION_WITHDRAW_STIMULATE=false
EXECUTOR_ID=6956717486b425cf9938c665
DEBUG_ENABLED=false
CACHE_TTL_WITHDRAW=5d
WINSTON_USE_CONSOLE=true
