{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/core/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/core/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/core",
  "projects": {
    "playground-docker-agent": {
      "type": "application",
      "root": "apps/playground-docker-agent",
      "entryFile": "main",
      "sourceRoot": "apps/playground-docker-agent/src",
      "compilerOptions": {
        "tsConfigPath": "apps/playground-docker-agent/tsconfig.app.json",
        "webpack": true,
        "webpackConfigPath": "apps/playground-docker-agent/webpack.config.cjs"
      }
    },
    "playground-k8s-agent": {
      "type": "application",
      "root": "apps/playground-k8s-agent",
      "entryFile": "main",
      "sourceRoot": "apps/playground-k8s-agent/src",
      "compilerOptions": {
        "tsConfigPath": "apps/playground-k8s-agent/tsconfig.app.json",
        "webpack": true,
        "webpackConfigPath": "apps/playground-k8s-agent/webpack.config.cjs"
      }
    },
    "playground-rag-agent": {
      "type": "application",
      "root": "apps/playground-rag-agent",
      "entryFile": "main",
      "sourceRoot": "apps/playground-rag-agent/src",
      "compilerOptions": {
        "tsConfigPath": "apps/playground-rag-agent/tsconfig.app.json",
        "webpack": true,
        "webpackConfigPath": "apps/playground-rag-agent/webpack.config.cjs"
      }
    },
    "core": {
      "type": "application",
      "root": "apps/core",
      "entryFile": "main",
      "sourceRoot": "apps/core/src",
      "compilerOptions": {
        "tsConfigPath": "apps/core/tsconfig.app.json",
        "webpack": true,
        "webpackConfigPath": "apps/core/webpack.config.cjs"
      }
    },
    "mock": {
      "type": "application",
      "root": "apps/mock",
      "entryFile": "main",
      "sourceRoot": "apps/mock/src",
      "compilerOptions": {
        "tsConfigPath": "apps/mock/tsconfig.app.json",
        "webpack": true,
        "webpackConfigPath": "apps/mock/webpack.config.cjs"
      }
    },
    "cli": {
      "type": "application",
      "root": "apps/cli",
      "entryFile": "main",
      "sourceRoot": "apps/cli/src",
      "compilerOptions": {
        "tsConfigPath": "apps/cli/tsconfig.app.json",
        "webpack": true,
        "webpackConfigPath": "apps/cli/webpack.config.cjs"
      }
    }
  }
}
