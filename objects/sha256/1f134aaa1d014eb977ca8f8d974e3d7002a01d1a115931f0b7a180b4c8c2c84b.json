  "rules": [
    {
      "id": "BR-01",
      "statement": "Study and Quick quiz are explicit sibling modes and never collapse into one ambiguous session.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001",
        "EV-010",
        "EV-011"
      ]
    },
    {
      "id": "BR-02",
      "statement": "A review or quiz session is persisted before navigation to focused work.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-006",
        "EV-010",
        "EV-011"
      ]
    },
    {
      "id": "BR-03",
      "statement": "Live work restores the persisted session identity, card order and acknowledged progress.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-006",
        "EV-010",
        "EV-011"
      ]
    },
    {
      "id": "BR-04",
      "statement": "Leaving unfinished Study or Quick quiz work preserves resumability; finishing early requires confirmation and reports only completed work.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-010",
        "EV-011"
      ]
    },
    {
      "id": "BR-05",
      "statement": "A live session route represents in-progress work and a dedicated result route represents completed work.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-010",
        "EV-011"
      ]
    },
    {
      "id": "BR-06",
      "statement": "Invalid, missing or expired sessions recover to a safe setup or overview with an explanation.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-010",
        "EV-011"
      ]
    },
    {
      "id": "BR-07",
      "statement": "Study scheduling, quiz scoring, access gates and route identity remain defined by existing backend and routed frontend contracts.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-006",
        "EV-009",
        "EV-010"
      ]
    },
    {
      "id": "BR-08",
      "statement": "Results prioritize weak-topic and contextual next-study actions over decorative celebration.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-010",
        "EV-011"
      ]
    },
    {
      "id": "BR-09",
      "statement": "Every remote-data surface exposes pending, ready, empty, failed and retry or recovery behavior.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-002",
        "EV-010",
        "EV-011"
      ]
    },
    {
      "id": "BR-10",
      "statement": "Foundation browsing supports pagination and can settle as pending, ready, empty, failed or partial.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-004",
        "EV-007"
      ]
    }
  ],
