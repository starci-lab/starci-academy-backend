  "project": "starci-academy",
  "featureId": "study-library",
  "title": "Study library",
  "summary": "A course-level flashcard hub leads learners into either spaced-repetition Study or a configurable Quick quiz, preserves unfinished work, and closes each run with actionable results while Foundations and Mind map remain complementary study tools.",
  "sources": [
    {
      "role": "fe",
      "repository": "https://github.com/starci-lab/starci-academy-fe.git",
      "head": "f14e3c24b4a087fb6d4bb09d73526964d3ecea3c"
    },
    {
      "role": "be",
      "repository": "https://github.com/starci-lab/starci-academy-backend",
      "head": "88a3959084772f9eaa0f5dcbc4e480d4356210f0"
    }
  ],
  "scope": {
    "includes": [
      "Flashcard mode entry and deck navigation",
      "Study overview, due queue, deck configuration, focused review, resume and result",
      "Quick quiz setup, history, stats, focused timed work, resume and result",
      "Loading, empty, error, invalid or expired session, completion retry and recovery states",
      "Foundation categories and resources",
      "Course mind map"
    ],
    "excludes": [
      "Standalone coding problems",
      "Mock interview assessment",
      "New backend contracts or changed scoring and scheduling algorithms",
      "Legacy visual design as product authority"
    ]
  },
  "actors": [
    {
      "id": "learner",
      "label": "Learner",
      "capabilities": [
        "Choose Study or Quick quiz",
        "Review due flashcards or a selected deck",
        "Start, pause or resume a persisted study session",
        "Configure and complete a Quick quiz",
        "Inspect results and continue into recommended study",
        "Browse foundation resources",
        "Open the course mind map"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-004",
        "EV-005",
        "EV-006",
        "EV-007",
        "EV-010",
        "EV-011"
      ]
    },
    {
      "id": "platform",
      "label": "StarCi Academy platform",
      "capabilities": [
        "Expose due work, mastery and resumable work",
        "Persist and restore review and quiz sessions",
        "Record progress and completion without changing contract semantics",
        "Return performance and next-study evidence",
        "List foundation resources"
      ],
      "evidenceIds": [
        "EV-006",
        "EV-007",
        "EV-010",
        "EV-011"
      ]
    }
  ],
  "flows": [
    {
      "id": "flashcard-entry",
      "title": "Enter flashcards",
      "trigger": "A learner opens the course flashcard route.",
      "steps": [
        {
          "id": "inspect-readiness",
          "actor": "learner",
          "action": "Inspect due work, mastery, decks and resumable work",
          "result": "The learner understands what can be continued or started",
          "surfaceId": "flashcard-library",
          "stateId": "flashcard-ready"
        },
        {
          "id": "choose-flashcard-mode",
          "actor": "learner",
          "action": "Choose Study or Quick quiz",
          "result": "The selected branch opens without losing route identity",
          "surfaceId": "flashcard-library",
          "stateId": "flashcard-ready"
        }
      ],
      "outcomes": [
        "The learner enters the right flashcard branch or resumes acknowledged work"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-009",
        "EV-010",
        "EV-011"
      ]
    },
    {
      "id": "flashcard-study",
      "title": "Study flashcards",
      "trigger": "A learner chooses Study or resumes a review session.",
      "steps": [
        {
          "id": "choose-study-source",
          "actor": "learner",
          "action": "Choose today's due queue or a deck",
          "result": "The learner receives the available review scope",
          "surfaceId": "flashcard-library",
          "stateId": "study-configuring"
        },
        {
          "id": "configure-study",
          "actor": "learner",
          "action": "For a deck, choose all cards or only due cards",
          "result": "A valid review scope is ready to persist",
          "surfaceId": "flashcard-library",
          "stateId": "study-configuring"
        },
        {
          "id": "persist-study",
          "actor": "platform",
          "action": "Persist the ordered review session before navigation",
          "result": "A resumable session identity is returned",
          "surfaceId": "flashcard-library",
          "stateId": "study-starting"
        },
        {
          "id": "work-study-card",
          "actor": "learner",
          "action": "Reveal the answer and rate recall as Again, Hard, Good or Easy",
          "result": "Acknowledged progress is saved and the learner advances",
          "surfaceId": "study-session",
          "stateId": "study-active"
        },
        {
          "id": "pause-or-finish-study",
          "actor": "learner",
          "action": "Leave for later, resume, or confirm finishing early",
          "result": "Unfinished work remains resumable or completed work is finalized honestly",
          "surfaceId": "study-session",
          "stateId": "study-saving"
        },
        {
          "id": "inspect-study-result",
          "actor": "learner",
          "action": "Inspect grades, duration, next due and weak topics",
          "result": "The learner returns to overview or opens recommended study",
          "surfaceId": "study-result",
          "stateId": "study-result"
        }
      ],
      "outcomes": [
        "The learner completes or safely pauses a persisted spaced-repetition run and receives a clear next study action"
      ],
      "evidenceIds": [
        "EV-002",
        "EV-006",
        "EV-009",
        "EV-010",
        "EV-011"
      ]
    },
    {
      "id": "flashcard-quick-quiz",
      "title": "Take a Quick quiz",
      "trigger": "A learner chooses Quick quiz or resumes a quiz session.",
      "steps": [
        {
          "id": "choose-quiz-view",
          "actor": "learner",
          "action": "Open Begin, History or Stats",
          "result": "The requested quiz setup or evidence view opens",
          "surfaceId": "flashcard-library",
          "stateId": "quiz-configuring"
        },
        {
          "id": "configure-quiz",
          "actor": "learner",
          "action": "Configure the run within existing scope, mode, level and naming capabilities",
          "result": "A playable quiz request is ready",
          "surfaceId": "flashcard-library",
          "stateId": "quiz-configuring"
        },
        {
          "id": "persist-quiz",
          "actor": "platform",
          "action": "Persist the playable timed run before navigation",
          "result": "A resumable quiz identity and deadline are returned",
          "surfaceId": "flashcard-library",
          "stateId": "quiz-starting"
        },
        {
          "id": "work-quiz-card",
          "actor": "learner",
          "action": "Answer each prompt, check it and reveal the solution",
          "result": "Per-card outcomes and progress are acknowledged",
          "surfaceId": "quick-quiz-session",
          "stateId": "quiz-active"
        },
        {
          "id": "pause-or-finish-quiz",
          "actor": "learner",
          "action": "Leave for later, resume, expire, or confirm finishing early",
          "result": "The platform restores valid work or finalizes completed evidence",
          "surfaceId": "quick-quiz-session",
          "stateId": "quiz-saving"
        },
        {
          "id": "inspect-quiz-result",
          "actor": "learner",
          "action": "Inspect coverage, XP, per-card outcomes and weak topics",
