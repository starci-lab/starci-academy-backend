  "acceptance": [
    {
      "id": "AC-01",
      "statement": "Wallet balance, transactions and invoices render as complete independent surfaces whose loading, empty, answered and refused states retain the same anatomy and recovery ownership.",
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-011"
      ]
    },
    {
      "id": "AC-02",
      "statement": "A positive VND amount can create a SePay wallet-top-up pay link and submit its signed fields to the returned external checkout endpoint.",
      "evidenceIds": [
        "EV-004",
        "EV-005",
        "EV-006",
        "EV-011"
      ]
    },
    {
      "id": "AC-03",
      "statement": "The UI claims top-up success only after refreshed wallet or transaction evidence confirms the provider-settled credit; cancellation or an unresolved return never claims success.",
      "evidenceIds": [
        "EV-003",
        "EV-007",
        "EV-008",
        "EV-010",
        "EV-011"
      ]
    },
    {
      "id": "AC-04",
      "statement": "Transaction and invoice management preserves real identities, statuses, dates, notes, amounts and actions at production-like density without fabricated totals.",
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-008",
        "EV-009",
        "EV-011"
      ]
    },
    {
      "id": "AC-05",
      "statement": "An owned unpaid invoice can be paid from wallet balance, after which every ledger refreshes and linked provisioning starts.",
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-009"
      ]
    },
    {
      "id": "AC-06",
      "statement": "Every desktop, collapsed-navigation, mobile and overlay state uses the one grammar-locked StarCi visual theme.",
