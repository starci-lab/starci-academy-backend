{
  "schemaVersion": 2,
  "project": "nivo",
  "featureId": "wallet-billing",
  "title": "Wallet, SePay top-up and billing management",
  "summary": "An authenticated account owner reviews the wallet, starts a real SePay top-up, returns to reconcile the credited balance and transaction ledger, and manages wallet transactions and service invoices from one coherent payment flow.",
  "sources": [
    {
      "role": "fe",
      "repository": "https://github.com/starci-lab/nivo-fe.git",
      "head": "385a4568195e59287d0555a1f473a80d85123411"
    },
    {
      "role": "be",
      "repository": "https://github.com/starci-lab/nivo-backend.git",
      "head": "947c6f4a117e1677e37ad98ba03f3dac0bca148e"
    }
  ],
  "scope": {
    "includes": [
      "Wallet balance with correct independent surface states",
      "SePay wallet top-up amount entry and signed external checkout handoff",
      "Return, cancellation and reconciliation states after checkout",
      "Wallet transaction history with direction, amount, note and date",
      "Invoice history, invoice detail and settlement from wallet balance",
      "Desktop and mobile payment flow under the strict StarCi visual grammar"
    ],
    "excludes": [
      "Frontend or backend source implementation in this business-analysis run",
      "An in-app SePay QR payload that the current API does not return",
      "Fabricated payment status, expiry or ledger totals absent from the current contract",
      "Changing or removing the backend's existing PayOS capability"
    ]
  },
  "actors": [
    {
      "id": "account-owner",
      "label": "Authenticated account owner",
      "capabilities": [
        "Review available wallet funds",
        "Start a SePay top-up and return for reconciliation",
        "Inspect wallet transactions and invoices",
        "Pay an owned unpaid invoice from wallet balance"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-004",
        "EV-006",
        "EV-010",
        "EV-011"
      ]
    }
  ],
  "flows": [
    {
      "id": "wallet-payment-journey",
      "title": "Top up and manage account payments",
      "trigger": "Open Wallet",
      "steps": [
        {
          "id": "open-wallet",
          "actor": "account-owner",
          "action": "Open Wallet and review balance, recent transactions and invoices",
          "result": "The account owner can top up, inspect money movement or settle an invoice",
          "surfaceId": "wallet-payment",
          "stateId": "wallet-ready"
        },
        {
          "id": "enter-top-up",
          "actor": "account-owner",
          "action": "Choose Top up and enter a positive VND amount with SePay selected",
          "result": "The amount is ready for pay-link creation",
          "surfaceId": "wallet-payment",
          "stateId": "top-up-entry"
        },
        {
          "id": "create-checkout",
          "actor": "account-owner",
          "action": "Create the SePay top-up checkout",
          "result": "A pending payment, reference, external checkout URL and signed form fields are returned",
          "surfaceId": "wallet-payment",
          "stateId": "checkout-creating"
        },
        {
          "id": "handoff-sepay",
          "actor": "account-owner",
          "action": "Continue to the signed SePay checkout",
          "result": "SePay owns payment collection and redirects to the supplied success or cancellation URL",
          "surfaceId": "wallet-payment",
          "stateId": "checkout-handoff"
        },
        {
          "id": "reconcile-return",
          "actor": "account-owner",
          "action": "Return to Wallet after provider success or cancellation",
          "result": "The wallet and transaction ledger refresh without inventing a settlement result",
          "surfaceId": "wallet-payment",
          "stateId": "reconciling"
        },
        {
          "id": "manage-ledgers",
          "actor": "account-owner",
          "action": "Inspect a transaction or invoice and pay an owned unpaid invoice when funds are sufficient",
          "result": "Money movement, invoice state and the resulting provisioning consequence remain traceable",
          "surfaceId": "wallet-payment",
          "stateId": "history-ready"
        }
      ],
      "outcomes": [
        "A confirmed SePay top-up credits the wallet exactly once and appears in the transaction ledger",
        "A cancelled or unresolved checkout does not claim that funds arrived",
        "An owned unpaid invoice can be settled from wallet balance and starts linked provisioning"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-004",
        "EV-005",
        "EV-006",
        "EV-007",
        "EV-008",
        "EV-009",
        "EV-010",
        "EV-011"
      ]
    }
  ],
  "rules": [
    {
      "id": "BR-01",
      "statement": "A first wallet read creates a real zero-balance wallet; zero is an answered value, not an absent wallet.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001",
        "EV-002"
      ]
    },
    {
      "id": "BR-02",
      "statement": "A SePay top-up accepts a positive VND amount, records a pending wallet-top-up payment and returns a reference, checkout endpoint and signed checkout fields before any wallet credit is claimed.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-004",
        "EV-005",
        "EV-006"
      ]
    },
    {
      "id": "BR-03",
      "statement": "Wallet credit occurs only after the authenticated SePay webhook retrieves a paid provider order and routes the matching wallet-top-up settlement.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-007",
        "EV-010"
      ]
    },
    {
      "id": "BR-04",
      "statement": "Wallet transactions are viewer-scoped and returned newest first with deposit or spend direction, amount, optional note and creation time.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-003",
        "EV-008"
      ]
    },
    {
      "id": "BR-05",
      "statement": "Invoice settlement is restricted to an owned unpaid invoice and starts provisioning for its linked service after payment.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001",
        "EV-009"
      ]
    },
    {
      "id": "BR-06",
      "statement": "Wallet, top-up, transaction and invoice states form one StarCi-themed payment journey on desktop and mobile; a project-local visual theme is not permitted.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-011"
      ]
    },
    {
      "id": "BR-07",
      "statement": "After checkout return, the frontend refreshes wallet and transaction facts and must not label the payment successful, failed or expired without an authoritative contract result.",
      "strength": "partial",
      "evidenceIds": [
        "EV-002",
        "EV-003",
        "EV-011"
      ]
    }
  ],
