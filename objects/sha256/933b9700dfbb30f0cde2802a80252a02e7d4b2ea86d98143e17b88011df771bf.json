    {
      "id": "AC-01",
      "statement": "Creating an AgentOS order establishes /[locale]/agentos/orders/[orderId] as the exact resumable journey context.",
      "evidenceIds": [
        "EV-001",
        "EV-003"
      ]
    },
    {
      "id": "AC-02",
      "statement": "The Wallet waypoint identifies and pays the invoice linked to that exact order and exposes a return to the same order rather than choosing an unrelated unpaid invoice.",
      "evidenceIds": [
        "EV-001",
        "EV-003",
        "EV-004"
      ]
    },
    {
      "id": "AC-03",
      "statement": "When provisioning resolves a ready workspaceId, the primary action opens /[locale]/agentos/workspaces/[workspaceId], not the generic AgentOS index.",
      "evidenceIds": [
        "EV-001",
        "EV-003",
        "EV-005"
      ]
    },
    {
      "id": "AC-04",
      "statement": "Module detail and OpenClaw launch are reachable only as optional branches from a ready exact workspace and are absent from required primary progress.",
      "evidenceIds": [
        "EV-001",
        "EV-006",
        "EV-007",
        "EV-009"
      ]
    },
    {
      "id": "AC-05",
      "statement": "Launch idle, opening, connected, blocked, expired and disconnected transitions remain independent from request, payment, provisioning and workspace readiness states.",
      "evidenceIds": [
        "EV-001",
        "EV-008",
        "EV-012",
        "EV-013"
      ]
    },
    {
      "id": "AC-06",
      "statement": "The control center renders no runnable update, plan change, backup, reset or rebuild control until the corresponding public backend operation exists.",
      "evidenceIds": [
        "EV-010"
      ]
    }
  ],
