    {
      "id": "module-post-ready-branch",
      "title": "Inspect an installed solution module after workspace readiness",
      "trigger": "The owner chooses a solution installation from the exact ready workspace",
      "steps": [
        {
          "id": "choose-module",
          "actor": "account-owner",
          "action": "Choose one installation belonging to the exact workspace",
          "result": "The nested module route preserves both workspace and installation identity",
          "surfaceId": "agentos-module",
          "stateId": "module-loading"
        },
        {
          "id": "inspect-module",
          "actor": "account-owner",
          "action": "Inspect package lifecycle and generated bindings",
          "result": "Module detail remains an optional branch from the ready workspace",
          "surfaceId": "agentos-module",
          "stateId": "module-ready"
