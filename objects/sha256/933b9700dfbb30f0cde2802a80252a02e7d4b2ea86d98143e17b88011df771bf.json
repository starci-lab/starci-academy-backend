    },
    {
      "id": "openclaw-post-ready-branch",
      "title": "Open a short-lived OpenClaw launch after workspace readiness",
      "trigger": "The owner chooses OpenClaw from the exact ready workspace",
      "steps": [
        {
          "id": "issue-launch",
          "actor": "account-owner",
          "action": "Issue a secure launch for the exact workspace",
          "result": "The launch axis advances from idle to opening",
          "surfaceId": "openclaw-launch",
          "stateId": "launch-opening"
        },
        {
          "id": "use-launch",
          "actor": "account-owner",
          "action": "Connect, renew, expire or revoke the short-lived launch",
          "result": "Launch state changes without changing workspace readiness",
          "surfaceId": "openclaw-launch",
          "stateId": "launch-connected"
        }
      ],
      "outcomes": [
        "OpenClaw access is optional, exact-workspace scoped and independently stateful"
