{
  "schemaVersion": 1,
  "project": "tedo",
  "featureId": "proposal-delivery",
  "title": "Proposal and document delivery",
  "summary": "TEDO confirms a complete project requirements revision, deterministically prices the scope or routes it to manual review, generates immutable brief/specification/proposal documents, and exposes those documents for download and internal visual preview.",
  "sources": [
    {
      "role": "fe",
      "repository": "https://github.com/starci-lab/tedo-landingpage.git",
      "head": "8c9f46e075dd18c99bd749237818ab4e2ebd4152"
    },
    {
      "role": "be",
      "repository": "https://github.com/starci-lab/tedo-backend.git",
      "head": "24b3dc4b0eda44638cff0b70888b8304af7814de"
    }
  ],
  "scope": {
    "includes": [
      "Requirements patch and confirmation",
      "Deterministic commercial estimate",
      "Manual-review and insufficient-scope outcomes",
      "Proposal generation from a confirmed revision",
      "Immutable document download",
      "Internal sample quote preview"
    ],
    "excludes": [
      "Electronic signature and contract acceptance",
      "Editing live customer data from the preview route",
      "Payment collection"
    ]
  },
  "actors": [
    {
      "id": "buyer",
      "label": "Prospective buyer",
      "capabilities": [
        "Complete and confirm project scope",
        "Request proposal generation",
        "Download generated documents",
        "Preview the proposal template with representative sample data"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-004",
        "EV-005",
        "EV-006",
        "EV-007",
        "EV-008",
        "EV-009",
        "EV-010"
      ]
    },
    {
      "id": "platform",
      "label": "TEDO platform",
      "capabilities": [
        "Persist requirements revisions",
        "Price a confirmed scope",
        "Generate immutable brief, specification and proposal documents",
        "Stream a project-owned document"
      ],
      "evidenceIds": [
        "EV-004",
        "EV-006",
        "EV-007",
        "EV-008",
        "EV-010"
      ]
    }
  ],
  "flows": [
    {
      "id": "proposal-delivery-journey",
      "title": "Proposal and document delivery",
      "trigger": "A consultation reaches complete project requirements and the buyer requests proposal documents.",
      "steps": [
        {
          "id": "complete-requirements",
          "actor": "buyer",
          "action": "Provide or amend required project scope fields",
          "result": "A new requirements revision is recorded",
          "surfaceId": "proposal-panel",
          "stateId": "requirements-partial"
        },
        {
          "id": "confirm-requirements",
          "actor": "buyer",
          "action": "Confirm the current complete revision",
          "result": "The immutable scope snapshot becomes eligible for pricing",
          "surfaceId": "proposal-panel",
          "stateId": "proposal-pending"
        },
        {
          "id": "generate-proposal",
          "actor": "platform",
          "action": "Price the confirmed scope and generate the document set",
          "result": "Brief, requirements specification and commercial proposal links are returned",
          "surfaceId": "proposal-panel",
          "stateId": "proposal-ready"
        },
        {
          "id": "download-document",
          "actor": "buyer",
          "action": "Open one generated document link",
          "result": "The immutable project-owned document is streamed",
          "surfaceId": "proposal-panel",
          "stateId": "proposal-ready"
        }
      ],
      "outcomes": [
        "The buyer receives versioned downloadable project documents derived from one confirmed scope"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-004",
        "EV-005",
        "EV-006",
        "EV-007",
        "EV-008",
        "EV-009",
        "EV-010"
      ]
    }
  ],
  "rules": [
    {
      "id": "BR-01",
      "statement": "Proposal generation requires a confirmed requirements revision and rejects incomplete scope.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-008"
      ]
    },
    {
      "id": "BR-02",
      "statement": "Pricing first returns insufficient-scope when discovery is incomplete, otherwise uses an exact comparable match or a component estimate with a 15 percent reference ceiling; review reasons force manual-review.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-007"
      ]
    },
    {
      "id": "BR-03",
      "statement": "Manual-review pricing cannot generate a proposal automatically.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-007",
        "EV-008"
      ]
    },
    {
      "id": "BR-04",
      "statement": "Each generation persists a versioned draft proposal and immutable brief, requirements specification and proposal documents.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-008"
      ]
    },
    {
      "id": "BR-05",
      "statement": "A document download succeeds only when the document id belongs to the requested project.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-006",
        "EV-008"
      ]
    },
    {
      "id": "BR-06",
      "statement": "The quote preview is no-index, uses checked-in sample data and is not an editor or a live-customer-data surface.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-009"
      ]
    }
  ],
