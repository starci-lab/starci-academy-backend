{
  "schemaVersion": 1,
  "project": "nivo",
  "featureId": "app-lifecycle",
  "title": "Template app lifecycle",
  "summary": "An authenticated owner browses template offers beside owned apps, starts the supported academy template, and follows its isolated provisioning snapshot through request, build, ready or failed states into its control center.",
  "sources": [
    {
      "role": "fe",
      "repository": "https://github.com/starci-lab/nivo-fe.git",
      "head": "97eec8c5bb4c8f4b9e4bb7c59ea771ed829841d9"
    },
    {
      "role": "be",
      "repository": "https://github.com/starci-lab/nivo-backend.git",
      "head": "947c6f4a117e1677e37ad98ba03f3dac0bca148e"
    }
  ],
  "scope": {
    "includes": [
      "Owned app fleet",
      "Template catalogue",
      "Academy template creation",
      "Provisioning progress and recovery",
      "Owned app management entry"
    ],
    "excludes": [
      "Provisioning catalogue templates not wired by the frontend",
      "Manual infrastructure operations outside published mutations"
    ]
  },
