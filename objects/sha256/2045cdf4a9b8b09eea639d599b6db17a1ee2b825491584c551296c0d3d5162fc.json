  "flows": [
    {
      "id": "app-lifecycle-journey",
      "title": "Template app lifecycle",
      "trigger": "Choose Build on a supported template",
      "steps": [
        {
          "id": "step-1",
          "actor": "account-actor",
          "action": "Choose Build on a supported template",
          "result": "Submit a stable app slug",
          "surfaceId": "apps-catalogue",
          "stateId": "catalog-loading"
        },
        {
          "id": "step-2",
          "actor": "account-actor",
          "action": "Submit a stable app slug",
          "result": "Follow deployment progress",
          "surfaceId": "template-app-provisioning",
          "stateId": "request"
        },
        {
          "id": "step-3",
          "actor": "account-actor",
          "action": "Follow deployment progress",
          "result": "Open the ready app control center",
          "surfaceId": "template-app-provisioning",
          "stateId": "submitting"
        },
        {
          "id": "step-4",
          "actor": "account-actor",
          "action": "Open the ready app control center",
          "result": "A draft expert site and deployment identity are created",
          "surfaceId": "template-app-provisioning",
          "stateId": "accepted"
        }
      ],
      "outcomes": [
        "A draft expert site and deployment identity are created",
        "A failed or unsupported request is shown explicitly"
      ],
