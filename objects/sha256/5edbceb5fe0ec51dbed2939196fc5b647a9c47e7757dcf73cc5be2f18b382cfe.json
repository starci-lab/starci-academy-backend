  "rules": [
    {
      "id": "BR-01",
      "statement": "Flashcard review distinguishes due work, deck statistics, resume state and pending/ready/empty/failed outcomes.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-002"
      ]
    },
    {
      "id": "BR-02",
      "statement": "Starting a flashcard review persists the chosen deck and card order as a resumable session.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-006"
      ]
    },
    {
      "id": "BR-03",
      "statement": "Foundation browsing supports pagination and can settle as pending, ready, empty, failed or partial.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-004",
        "EV-007"
      ]
    }
  ],
