  "flows": [
    {
      "id": "study-library-journey",
      "title": "Study library",
      "trigger": "A learner opens a course study-tool route.",
      "steps": [
        {
          "id": "choose-study-mode",
          "actor": "learner",
          "action": "Choose flashcards, foundations or mind map",
          "result": "The selected study surface opens",
          "surfaceId": "flashcard-library",
          "stateId": "study-ready"
        },
        {
          "id": "start-review",
          "actor": "learner",
          "action": "Start or resume a due/deck flashcard session",
          "result": "A persisted ordered review session is returned",
          "surfaceId": "flashcard-library",
          "stateId": "study-pending"
        },
        {
          "id": "browse-foundations",
          "actor": "learner",
          "action": "Search or page foundation categories and open a resource",
          "result": "The selected reference content opens",
          "surfaceId": "foundation-library",
          "stateId": "study-ready"
        }
      ],
      "outcomes": [
        "The learner receives a resumable study session or reaches the selected reference material"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-004",
        "EV-005",
        "EV-006",
        "EV-007"
      ]
    }
