{
  "schemaVersion": 2,
  "authority": {
    "status": "pending",
    "basis": "owner-intent",
    "requiredRoles": [
      "fe"
    ]
  },
  "project": "nivo",
  "featureId": "app-dashboard-create-flows",
  "title": "Separated app dashboards and create flows",
  "summary": "Authenticated owners manage existing AgentOS workspaces and Template Apps on dashboard-only routes, start new resources on separate pre-persistence create routes, and resume persisted resources only on order-, workspace-, or site-owned routes.",
  "sources": [
    {
      "role": "fe",
      "repository": "https://github.com/starci-lab/nivo-fe.git",
      "head": "894e608bba73d791e5d2767cdc420da770c8c42b"
    }
  ],
  "scope": {
    "includes": [
      "AgentOS management dashboard at /:locale/agentos without an embedded create or provisioning form.",
      "AgentOS pre-persistence creation at /:locale/agentos/create and post-persistence resume at /:locale/agentos/orders/:orderId.",
      "AgentOS terminal management at /:locale/agentos/workspaces/:workspaceId.",
      "Template Apps management dashboard at /:locale/apps without an embedded create or provisioning form.",
      "Template App pre-persistence creation at /:locale/apps/create/:templateKey and post-persistence resume at /:locale/apps/:siteId/provisioning.",
      "Template App terminal management at /:locale/apps/:siteId."
    ],
    "excludes": [
      "Backend API, schema or lifecycle changes.",
      "Changes to AgentOS order, payment or provisioning semantics.",
      "Changes to Template App deployment semantics or template eligibility.",
      "Persisted order, workspace or site identifiers on a create route.",
      "A generic Template App order route that the current site-creation contract does not return."
    ]
  },
  "actors": [
    {
      "id": "app-owner",
      "label": "Authenticated Nivo app owner",
      "capabilities": [
        "Manage existing AgentOS workspaces and Template Apps from product dashboards.",
        "Start a new AgentOS order or selected Template App from a dedicated pre-persistence route.",
        "Resume a persisted resource from its order, workspace or site route."
      ],
      "evidenceIds": [
        "EV-001",
        "EV-003",
        "EV-004",
        "EV-005",
        "EV-009",
        "EV-010"
      ]
    }
  ],
  "flows": [
    {
      "id": "agentos-dashboard-create-flow",
      "title": "Manage and create AgentOS workspaces",
      "trigger": "An authenticated owner opens the AgentOS product dashboard or chooses its create action.",
      "steps": [
        {
          "id": "review-agentos-dashboard",
          "actor": "app-owner",
          "action": "Review existing AgentOS workspaces on the management-only dashboard.",
          "result": "The owner can manage an existing workspace or navigate to the separate create route.",
          "surfaceId": "agentos-dashboard",
          "stateId": "dashboard-ready"
        },
        {
          "id": "open-agentos-create",
          "actor": "app-owner",
          "action": "Open /:locale/agentos/create without a persisted identifier.",
          "result": "A new AgentOS request can be entered independently of the workspace list.",
          "surfaceId": "agentos-create",
          "stateId": "create-ready"
        },
        {
          "id": "resume-agentos-order",
          "actor": "app-owner",
          "action": "Continue on /:locale/agentos/orders/:orderId after order persistence.",
          "result": "The persisted order owns its payment and provisioning resume state.",
          "surfaceId": "agentos-order-resume",
          "stateId": "resource-resume"
        },
        {
          "id": "manage-agentos-workspace",
          "actor": "app-owner",
          "action": "Open /:locale/agentos/workspaces/:workspaceId after workspace readiness.",
          "result": "The persisted workspace owns its terminal management experience.",
          "surfaceId": "agentos-workspace",
          "stateId": "resource-ready"
        }
      ],
      "outcomes": [
        "AgentOS dashboard management, pre-persistence creation, persisted-order resume and terminal workspace management each have one unambiguous route owner."
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-004"
      ]
    },
    {
      "id": "template-dashboard-create-flow",
      "title": "Manage and create Template Apps",
      "trigger": "An authenticated owner opens the Apps dashboard or chooses a catalogue template to build.",
      "steps": [
        {
          "id": "review-apps-dashboard",
          "actor": "app-owner",
          "action": "Review existing sites and available templates on the management-only Apps dashboard.",
          "result": "The owner can open an existing site or navigate to the selected template create route.",
          "surfaceId": "apps-dashboard",
          "stateId": "dashboard-ready"
        },
        {
          "id": "open-template-create",
          "actor": "app-owner",
          "action": "Open /:locale/apps/create/:templateKey before a site exists.",
          "result": "The selected template provides create context without pretending to be a persisted site.",
          "surfaceId": "template-app-create",
          "stateId": "create-ready"
        },
        {
          "id": "resume-template-provisioning",
          "actor": "app-owner",
          "action": "Continue on /:locale/apps/:siteId/provisioning after site persistence.",
          "result": "The persisted site owns deployment resume state.",
          "surfaceId": "template-app-provisioning",
          "stateId": "resource-resume"
        },
        {
          "id": "manage-template-app",
          "actor": "app-owner",
          "action": "Open /:locale/apps/:siteId after deployment readiness.",
          "result": "The persisted site owns its terminal management experience.",
          "surfaceId": "template-app-control-center",
          "stateId": "resource-ready"
        }
      ],
      "outcomes": [
        "Template Apps dashboard management, template-keyed creation, site-owned provisioning and terminal site management each have one unambiguous route owner."
      ],
      "evidenceIds": [
        "EV-001",
        "EV-005",
        "EV-006",
        "EV-007",
        "EV-008",
        "EV-009",
        "EV-010"
      ]
    }
  ],
  "rules": [
    {
      "id": "BR-01",
      "statement": "AgentOS and Template Apps dashboards manage and navigate existing instances; they never render an embedded create or provisioning form.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-005"
      ]
    },
    {
      "id": "BR-02",
      "statement": "A create route is pre-persistence and therefore carries no orderId, workspaceId or siteId.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001",
        "EV-003",
        "EV-004",
        "EV-006",
        "EV-009",
        "EV-010"
      ]
    },
    {
      "id": "BR-03",
      "statement": "AgentOS creation begins at /:locale/agentos/create and, after persistence, resumes at /:locale/agentos/orders/:orderId before terminal management at /:locale/agentos/workspaces/:workspaceId.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001",
        "EV-003",
        "EV-004"
      ]
    },
    {
      "id": "BR-04",
      "statement": "A templateKey is allowed on /:locale/apps/create/:templateKey because it identifies the chosen template, not a persisted app instance.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001",
        "EV-006",
        "EV-007"
      ]
    },
    {
      "id": "BR-05",
      "statement": "Template App creation resumes at /:locale/apps/:siteId/provisioning after site persistence and terminates at /:locale/apps/:siteId; it does not invent a separate order identity.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001",
        "EV-008",
        "EV-009",
        "EV-010"
      ]
    },
    {
      "id": "BR-06",
      "statement": "The route split changes frontend composition only and preserves the existing backend lifecycle and eligibility contracts.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001",
        "EV-003",
        "EV-008",
        "EV-009"
      ]
    }
  ],
