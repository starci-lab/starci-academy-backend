{
  "schemaVersion": 1,
  "project": "tedo",
  "featureId": "consultation-discovery",
  "title": "Consultation and project discovery",
  "summary": "Prospective buyers start or restore an AI-assisted consultation, exchange messages and attachments, progressively capture project requirements and quote guidance, then provide consented contact details for human follow-up.",
  "sources": [
    {
      "role": "fe",
      "repository": "https://github.com/starci-lab/tedo-landingpage.git",
      "head": "8c9f46e075dd18c99bd749237818ab4e2ebd4152"
    },
    {
      "role": "be",
      "repository": "https://github.com/starci-lab/tedo-backend.git",
      "head": "24b3dc4b0eda44638cff0b70888b8304af7814de"
    }
  ],
  "scope": {
    "includes": [
      "New and restored consultation routes",
      "Prompt suggestions and message submission",
      "Conversation persistence and attachments",
      "Progressive requirements discovery",
      "Indicative or manual-review quote guidance",
      "Consented lead qualification"
    ],
    "excludes": [
      "Final commercial approval and signed contract",
      "Generated proposal documents after requirements confirmation"
    ]
  },
  "actors": [
    {
      "id": "buyer",
      "label": "Prospective buyer",
      "capabilities": [
        "Describe a project in natural language",
        "Use a suggested starting prompt",
        "Resume a saved consultation",
        "Attach supporting material",
        "Answer missing-scope questions",
        "Submit consented contact details"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-004",
        "EV-005",
        "EV-006",
        "EV-007",
        "EV-008"
      ]
    },
    {
      "id": "platform",
      "label": "TEDO platform",
      "capabilities": [
        "Persist consultation messages and requirements",
        "Retrieve relevant knowledge",
        "Extract project scope",
        "Estimate quote status",
        "Save a qualified lead"
      ],
      "evidenceIds": [
        "EV-005",
        "EV-006",
        "EV-007",
        "EV-008"
      ]
    }
  ],
  "flows": [
    {
      "id": "consultation-discovery-journey",
      "title": "Consultation and project discovery",
      "trigger": "A buyer submits a project prompt from the landing page or opens the consultation route.",
      "steps": [
        {
          "id": "start-conversation",
          "actor": "buyer",
          "action": "Submit a free-text project prompt or a suggestion",
          "result": "A new consultation message is sent",
          "surfaceId": "consultation-chat",
          "stateId": "conversation-pending"
        },
        {
          "id": "discover-requirements",
          "actor": "platform",
          "action": "Extract known scope and ask the next applicable missing questions",
          "result": "The durable requirements revision advances",
          "surfaceId": "consultation-chat",
          "stateId": "discovery-partial"
        },
        {
          "id": "resume-conversation",
          "actor": "buyer",
          "action": "Open a validated saved conversation id",
          "result": "Message history and current requirements are restored",
          "surfaceId": "saved-consultation",
          "stateId": "conversation-ready"
        },
        {
          "id": "qualify-lead",
          "actor": "buyer",
          "action": "Submit contact details, preferred channel and consent",
          "result": "A reachable lead is saved against the conversation",
          "surfaceId": "consultation-chat",
          "stateId": "lead-pending"
        }
      ],
      "outcomes": [
        "TEDO holds a durable consultation, its current requirements revision and an optional consented follow-up lead"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-004",
        "EV-005",
        "EV-006",
        "EV-007",
        "EV-008"
      ]
    }
  ],
  "rules": [
    {
      "id": "BR-01",
      "statement": "A saved consultation route accepts only a UUID-shaped conversation id; invalid identifiers resolve as not found.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-002"
      ]
    },
    {
      "id": "BR-02",
      "statement": "The discovery engine asks only applicable unanswered questions and expands module choices from the selected product type.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-008"
      ]
    },
    {
      "id": "BR-03",
      "statement": "An empty message is accepted only when files are attached, in which case the system supplies an attachment-analysis message.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-005"
      ]
    },
    {
      "id": "BR-04",
      "statement": "Human follow-up requires contact identity, a preferred channel and affirmative consent tied to the conversation.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-004",
        "EV-007"
      ]
    },
    {
      "id": "BR-05",
      "statement": "Pricing may settle as priced, insufficient-scope or manual-review; manual negotiation intent remains manual-review rather than fabricated automatic pricing.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-006"
      ]
    }
  ],
