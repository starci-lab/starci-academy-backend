{
  "schemaVersion": 1,
  "project": "starci-academy",
  "featureId": "progress-profile",
  "title": "Progress, profile and league",
  "summary": "Authenticated learners review their learning dashboard, quests, streak, goals, job readiness and community tabs; inspect public profile evidence; update profile settings; and compare weekly or global league standing.",
  "sources": [
    {
      "role": "fe",
      "repository": "https://github.com/starci-lab/starci-academy-fe.git",
      "head": "84bf3be6565a20b1fee9c83cab8b9ba810d13e11"
    },
    {
      "role": "be",
      "repository": "https://github.com/starci-lab/starci-academy-backend",
      "head": "0066625ed94b10bf5b6892af775e45bdd6823558"
    }
  ],
  "scope": {
    "includes": [
      "Authenticated dashboard overview, explore, courses and community tabs",
      "Daily quest and progress evidence",
      "Public profile overview and related profile routes",
      "Profile updates",
      "Weekly/global league surface"
    ],
    "excludes": [
      "Course-specific learning execution",
      "Private administrative user management"
    ]
  },
  "actors": [
    {
      "id": "learner",
      "label": "Learner",
      "capabilities": [
        "Review personal learning progress",
        "Claim completed daily quest rewards",
        "Inspect public profile evidence",
        "Update editable profile fields",
        "Compare league standing"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-004",
        "EV-005",
        "EV-006",
        "EV-007",
        "EV-008",
        "EV-009"
      ]
    },
    {
      "id": "platform",
      "label": "StarCi Academy platform",
      "capabilities": [
        "Persist partial profile updates",
        "Grant one completed daily quest reward",
        "Return weekly league standing"
      ],
      "evidenceIds": [
        "EV-007",
        "EV-008",
        "EV-009"
      ]
    }
  ],
  "flows": [
    {
      "id": "progress-profile-journey",
      "title": "Progress, profile and league",
      "trigger": "An authenticated learner opens the dashboard or a profile/league route.",
      "steps": [
        {
          "id": "review-dashboard",
          "actor": "learner",
          "action": "Open dashboard overview or another dashboard tab",
          "result": "Identity, learning, quest, streak, goals and community regions settle independently",
          "surfaceId": "learning-dashboard",
          "stateId": "progress-ready"
        },
        {
          "id": "claim-quest",
          "actor": "learner",
          "action": "Claim a completed daily quest",
          "result": "Points are granted once for the day",
          "surfaceId": "learning-dashboard",
          "stateId": "progress-pending"
        },
        {
          "id": "inspect-profile",
          "actor": "learner",
          "action": "Open a public profile or evidence subroute",
          "result": "Public learning, project, challenge and skill evidence is displayed",
          "surfaceId": "public-profile",
          "stateId": "progress-ready"
        },
        {
          "id": "view-league",
          "actor": "learner",
          "action": "Choose weekly or global standing",
          "result": "Podium, viewer standing and ranked rows are displayed",
          "surfaceId": "league-standing",
          "stateId": "progress-ready"
        }
      ],
      "outcomes": [
        "The learner can understand current progress, public evidence and comparative standing"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-004",
        "EV-005",
        "EV-006",
        "EV-007",
        "EV-008",
        "EV-009"
      ]
    }
  ],
  "rules": [
    {
      "id": "BR-01",
      "statement": "The dashboard is authenticated and keeps overview blocks independently settling rather than treating the whole page as one request.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001",
        "EV-002"
      ]
    },
    {
      "id": "BR-02",
      "statement": "Profile updates are partial: omitted keys remain unchanged, explicit null clears nullable fields, strings are trimmed where declared, and the refreshed row is returned.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-007"
      ]
    },
    {
      "id": "BR-03",
      "statement": "A daily quest reward can be claimed only after completion and only once per day in one atomic grant.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-008"
      ]
    },
    {
      "id": "BR-04",
      "statement": "The league surface supports weekly and global scopes and preserves the viewer's own standing alongside ranked identities.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-005",
        "EV-006",
        "EV-009"
      ]
    }
  ],
