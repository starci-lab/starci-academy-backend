{
  "schemaVersion": 1,
  "project": "starci-academy",
  "featureId": "course-marketplace",
  "title": "Course marketplace and checkout",
  "summary": "Visitors discover localized courses, inspect curriculum and pricing evidence, collect courses in a personal cart, and start one authenticated checkout for the selected course set.",
  "sources": [
    {
      "role": "fe",
      "repository": "https://github.com/starci-lab/starci-academy-fe.git",
      "head": "84bf3be6565a20b1fee9c83cab8b9ba810d13e11"
    },
    {
      "role": "be",
      "repository": "https://github.com/starci-lab/starci-academy-backend",
      "head": "0ed7b7bc8e1bcd8c7dc684856f2a15ed798ad57b"
    }
  ],
  "scope": {
    "includes": [
      "Course catalog search, view and pagination",
      "Course detail overview, curriculum, reviews, FAQ and pricing rail",
      "Personal cart lines, totals, empty/error handling and checkout"
    ],
    "excludes": [
      "Payment-provider webhook settlement after checkout leaves the application",
      "Administrative course authoring"
    ]
  },
  "actors": [
    {
      "id": "learner",
      "label": "Learner",
      "capabilities": [
        "Browse and search courses",
        "Inspect a course",
        "Manage a personal cart",
        "Start checkout"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-004",
        "EV-005",
        "EV-006",
        "EV-007"
      ]
    },
    {
      "id": "platform",
      "label": "StarCi Academy platform",
      "capabilities": [
        "Return catalog and detail data",
        "Price a cart",
        "Create an order with one line per course"
      ],
      "evidenceIds": [
        "EV-007"
      ]
    }
  ],
  "flows": [
    {
      "id": "course-marketplace-journey",
      "title": "Course marketplace and checkout",
      "trigger": "A visitor opens the course catalog.",
      "steps": [
        {
          "id": "browse-courses",
          "actor": "learner",
          "action": "Search, page or change the catalog view",
          "result": "A course set is displayed",
          "surfaceId": "course-catalog",
          "stateId": "marketplace-ready"
        },
        {
          "id": "inspect-course",
          "actor": "learner",
          "action": "Open a course and review its curriculum, prerequisites, reviews, FAQ and offer",
          "result": "The course decision surface is displayed",
          "surfaceId": "course-detail",
          "stateId": "marketplace-ready"
        },
        {
          "id": "checkout-cart",
          "actor": "learner",
          "action": "Proceed with the selected cart lines",
          "result": "The backend starts one checkout order for the selected courses",
          "surfaceId": "shopping-cart",
          "stateId": "checkout-pending"
        }
      ],
      "outcomes": [
        "The learner receives a checkout result for the selected course set"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-004",
        "EV-005",
        "EV-006",
        "EV-007"
      ]
    }
  ],
  "rules": [
    {
      "id": "BR-01",
      "statement": "The catalog distinguishes pending, empty, filtered-empty, failed and populated states, and supports search, view and pagination controls.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-004"
      ]
    },
    {
      "id": "BR-02",
      "statement": "The cart is viewer-owned, hides totals and checkout actions when empty or unreadable, and requires confirmation before clearing all lines.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-003",
        "EV-006"
      ]
    },
    {
      "id": "BR-03",
      "statement": "Checkout requires authentication and creates one order with one line per submitted course.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-007"
      ]
    }
  ],
  "states": [
    {
      "id": "marketplace-ready",
      "label": "Marketplace ready",
      "kind": "initial",
      "transitions": [
        "checkout-pending"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-004",
        "EV-005"
