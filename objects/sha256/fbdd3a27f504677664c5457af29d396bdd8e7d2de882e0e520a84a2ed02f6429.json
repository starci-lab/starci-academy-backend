  "project": "starci-academy",
  "featureId": "projects-career",
  "title": "Projects and career",
  "summary": "Learners move through a course personal-project loop from roadmap to task, explicit repository and AI-grading intent, asynchronous evidence, revision and next-task handoff while career destinations remain discoverable.",
  "sources": [
    {
      "role": "fe",
