  "flows": [
    {
      "id": "personal-project-learning-loop",
      "title": "Personal project learning loop",
      "trigger": "An enrolled learner opens the personal-project roadmap.",
      "steps": [
        {
          "id": "open-roadmap",
          "actor": "learner",
          "action": "Open the roadmap and resume pointer",
          "result": "The next backend-determined task, project progress and repository summary are visible",
          "surfaceId": "personal-project-roadmap",
          "stateId": "project-ready"
        },
        {
          "id": "open-project-task",
          "actor": "learner",
          "action": "Open an available task and read its authored brief",
          "result": "The brief remains readable independently of repository, model-catalog or history recovery",
          "surfaceId": "personal-project-task",
          "stateId": "task-ready"
        },
        {
          "id": "configure-review",
          "actor": "learner",
          "action": "Choose language, Auto or an eligible concrete model, branch and optional private token",
          "result": "The active review intent is summarized in the task workspace",
          "surfaceId": "personal-project-task",
          "stateId": "settings-ready"
        },
        {
          "id": "submit-review",
          "actor": "learner",
          "action": "Submit repository evidence once",
          "result": "One validated asynchronous review job is created with the active language and model intent",
          "surfaceId": "personal-project-task",
          "stateId": "grading-queued"
        },
        {
          "id": "observe-grading",
          "actor": "learner",
          "action": "Observe queued or processing state and return after reload",
          "result": "The same in-flight review remains attributable and accidental duplicate submission is prevented",
          "surfaceId": "personal-project-task",
          "stateId": "grading-processing"
        },
        {
          "id": "inspect-result",
          "actor": "learner",
          "action": "Open the completed attempt",
          "result": "Score, verdict, served model, time and structured findings stay coherent for the selected attempt",
          "surfaceId": "personal-project-result",
          "stateId": "result-ready"
        },
        {
          "id": "revise-or-continue",
          "actor": "learner",
          "action": "Return to revise after failure or continue after pass",
          "result": "Settings are preserved for revision or the backend-determined next task opens",
          "surfaceId": "personal-project-result",
          "stateId": "revision-ready"
        }
      ],
      "outcomes": [
        "The learner can finish a personal-project milestone through traceable repository and AI-grading evidence without losing course context."
      ],
