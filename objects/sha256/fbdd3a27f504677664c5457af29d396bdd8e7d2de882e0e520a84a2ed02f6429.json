    {
      "id": "PP-AC-01",
      "statement": "Roadmap, task, result, settings and history render pending, ready, empty, denied, partial and recoverable failure states without losing semantic navigation.",
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-009",
        "EV-010"
      ]
    },
    {
      "id": "PP-AC-02",
      "statement": "Changing language changes the selected brief or implementation where authored and the same language is included in the review request.",
      "evidenceIds": [
        "EV-011",
        "EV-012",
        "EV-014"
      ]
    },
    {
      "id": "PP-AC-03",
      "statement": "Selecting a concrete model sends its model and provider; selecting Auto omits both; the result shows the actual served model.",
      "evidenceIds": [
        "EV-010",
        "EV-011",
        "EV-012",
        "EV-013",
        "EV-014"
      ]
    },
    {
      "id": "PP-AC-04",
      "statement": "Unavailable or unentitled models cannot be submitted and explain why; availability changing during submit returns an actionable error.",
      "evidenceIds": [
        "EV-011",
        "EV-012"
      ]
    },
    {
      "id": "PP-AC-05",
      "statement": "Private-token save, replace and clear never expose the token and only return the last-four indicator.",
      "evidenceIds": [
        "EV-015"
      ]
    },
    {
      "id": "PP-AC-06",
      "statement": "Queued and processing grading survives reload, prevents accidental duplicate review and resolves to completed or retryable failed state.",
      "evidenceIds": [
        "EV-010",
        "EV-016"
      ]
    },
    {
      "id": "PP-AC-07",
      "statement": "Attempt history is newest-first; selecting an attempt changes score, served model and feedback together; paging preserves selected identity.",
      "evidenceIds": [
        "EV-013"
      ]
    },
    {
      "id": "PP-AC-08",
      "statement": "A failed result links back to revision with settings preserved; a passed result links to the backend-determined next task.",
      "evidenceIds": [
        "EV-004",
        "EV-010",
        "EV-013"
      ]
    },
    {
      "id": "PP-AC-09",
      "statement": "The task brief remains usable when repository, model catalog, attempt-history or feedback data is unavailable.",
      "evidenceIds": [
        "EV-009",
        "EV-010"
      ]
    },
    {
      "id": "PP-AC-10",
      "statement": "Joint UAT runs Challenge and Personal Project after both are delivered while defects and authority remain attributed to their owning branch.",
      "evidenceIds": [
        "EV-010"
      ]
    },
