  "rules": [
    {
      "id": "PP-01",
      "statement": "Only an authenticated learner enrolled in the course may submit or inspect private personal-project grading evidence.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-007",
        "EV-010"
      ]
    },
    {
      "id": "PP-02",
      "statement": "The roadmap exposes deterministic milestone order, next task, completion, attempt count and score evidence; availability follows course progress rather than UI-local state.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-004",
        "EV-010"
      ]
    },
    {
      "id": "PP-03",
      "statement": "The authored task brief remains readable when repository, model-catalog, attempt-history or feedback dependencies fail.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-009",
        "EV-010"
      ]
    },
    {
      "id": "PP-04",
      "statement": "Repository URL, branch and private-token settings belong to the course enrollment and are reused across tasks; the token is write-only and only a last-four indicator may return.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-007",
        "EV-015"
      ]
    },
    {
      "id": "PP-05",
      "statement": "The learner chooses the grading language and may deliberately choose Auto or any currently eligible concrete model. A concrete choice sends both model and provider; Auto delegates selection to the backend.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-010",
        "EV-011",
        "EV-012",
        "EV-014"
      ]
    },
    {
      "id": "PP-06",
      "statement": "A submitted attempt binds task, repository URL, branch, language and grading choice as one review intent. A visible model selection that is not submitted is a contract failure.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-010",
        "EV-011",
        "EV-012"
      ]
    },
    {
      "id": "PP-07",
      "statement": "Each submission creates one asynchronous attempt. Queued, processing, failed and completed states remain distinguishable, and retry must not silently duplicate an in-flight attempt.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-012",
        "EV-016"
      ]
    },
    {
      "id": "PP-08",
      "statement": "Completed attempts are immutable, newest-first and independently selectable. The result identifies score, verdict, served model or provider, time and structured findings.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-003",
        "EV-013"
      ]
    },
    {
      "id": "PP-09",
      "statement": "A failed attempt returns the learner to revision with preserved settings and actionable findings; a passed attempt unlocks the deterministic next task.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-004",
        "EV-010",
        "EV-013"
      ]
    },
    {
      "id": "PP-10",
      "statement": "Unavailable or unentitled models explain their unavailable state and cannot be submitted; a model becoming unavailable during submit yields actionable recovery.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-011",
        "EV-012"
      ]
    },
    {
      "id": "PP-11",
      "statement": "Personal Project remains independent from Challenge while their AI-grading behavior may be UAT-tested together after both deliveries.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-010"
      ]
    },
    {
      "id": "BR-03",
      "statement": "The headhunting directory separates company and consultant results and can mark individual actions unavailable.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-005",
        "EV-008"
      ]
    }
  ],
