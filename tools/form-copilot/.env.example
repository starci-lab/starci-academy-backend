# Local fixed-form rehearsal configuration. No AI key is required.
DATABASE_URL=postgresql://form_copilot:form_copilot@127.0.0.1:54329/form_copilot

FORM_COPILOT_PORT=4317
FORM_COPILOT_HOST=127.0.0.1

FORM_COPILOT_ENABLE_SUBMISSIONS=false
FORM_COPILOT_BROWSER_HEADLESS=true
FORM_COPILOT_PUBLIC_ORIGINS=http://127.0.0.1:4317,http://localhost:4317,http://127.0.0.1:5173,http://localhost:5173

# Production/macOS service requires a unique password of at least 20 characters.
# VPS deployment has a separate template at infra/vps/.env.example.
FORM_COPILOT_AUTH_USER=operator
FORM_COPILOT_AUTH_PASSWORD=
