# Keep the real production env outside the release, chmod 600. Do not reuse local .env.local.
# Generate distinct hexadecimal secrets; URL-reserved characters in POSTGRES_PASSWORD need encoding.
POSTGRES_PASSWORD=replace_with_64_random_hex_characters
FORM_COPILOT_AUTH_USER=operator
FORM_COPILOT_AUTH_PASSWORD=replace_with_a_separate_64_random_hex_secret
FORM_COPILOT_ENABLE_SUBMISSIONS=false
FORM_COPILOT_IMAGE=form-copilot:local
