extends layouts/base

block content
  - var vi = locale === 'vi'
  - var deviceLine = [browser, os, deviceType].filter(Boolean).join(' · ')
  p.eyebrow= vi ? 'Bảo mật tài khoản' : 'Account security'
  h1= vi ? 'Có đăng nhập mới vào tài khoản' : 'New sign-in to your account'
  p= vi ? `Chào ${name}, chúng tôi vừa ghi nhận một lượt đăng nhập từ thiết bị mới.` : `Hi ${name}, we noticed a sign-in from a new device.`

  div(style="margin:0 0 24px; padding:16px 18px; background:#f6f6f6; border:1px solid #ececec; border-radius:12px; font-size:14px; color:#3f3d3e; line-height:1.7;")
    if deviceLine
      div
        span(style="color:#a3a1a2;")= vi ? 'Thiết bị: ' : 'Device: '
        strong= deviceLine
    if location
      div
        span(style="color:#a3a1a2;")= vi ? 'Vị trí: ' : 'Location: '
        strong= location
    if ipAddress
      div
        span(style="color:#a3a1a2;") IP:
        |
        strong= ipAddress

  div(style="margin:0 0 28px; padding:14px 18px; background:#fff5f9; border:1px solid #ffd9e8; border-radius:12px; font-size:14px; color:#99095c;")
    | #{vi ? 'Không phải bạn? Hãy đổi mật khẩu ngay và đăng xuất các thiết bị lạ trong phần Phiên đăng nhập.' : 'Not you? Change your password immediately and sign out unknown devices from your Sessions page.'}

  a.btn-primary(href=dashboardUrl)= vi ? 'Xem phiên đăng nhập →' : 'Review your sessions →'
