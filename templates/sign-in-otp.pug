extends layouts/base

block content
  h1 Confirm your sign-in
  p Enter this code to confirm it’s really you signing in.
  .otp-row
    - var digits = String(otp).split('')
    each d, i in digits
      span.otp-cell(class=(i === digits.length - 1 ? 'last' : ''))= d
  p.muted(style="margin-bottom:0;") This code expires in #{expiresInMinutes} minutes.
  .divider
  p.muted(style="margin-bottom:0;") Didn’t request this? You can safely ignore this email — no changes will be made to your account.
