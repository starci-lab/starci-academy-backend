//- ─────────────────────────────────────────────────
//- Base layout for all Starci Academy emails.
//- Provides a branded wrapper, header, footer, and
//- a `block content` slot for child templates.
//- ─────────────────────────────────────────────────
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    style.
      /* Reset */
      body, table, td, p, a, li { margin: 0; padding: 0; }
      body { width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
      table { border-collapse: collapse; }
      img { border: 0; outline: none; text-decoration: none; }

      /* Wrapper */
      .email-wrapper {
        max-width: 600px;
        margin: 0 auto;
        font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
      }

      /* Header */
      .email-header {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        padding: 32px 24px;
        text-align: center;
      }
      .email-header h1 {
        color: #ffffff;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.5px;
      }

      /* Body */
      .email-body {
        padding: 32px 24px;
        color: #374151;
        font-size: 15px;
        line-height: 1.7;
      }

      /* Button */
      .btn-primary {
        display: inline-block;
        padding: 12px 28px;
        margin: 24px 0;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        font-size: 15px;
      }

      /* Footer */
      .email-footer {
        background-color: #f9fafb;
        padding: 20px 24px;
        text-align: center;
        font-size: 12px;
        color: #9ca3af;
      }
      .email-footer a {
        color: #6366f1;
        text-decoration: none;
      }

  body(style="background-color: #f3f4f6; padding: 24px 0;")
    table.email-wrapper(role="presentation" cellpadding="0" cellspacing="0" width="100%")
      //- Header
      tr
        td.email-header
          h1 ⭐ Starci Academy

      //- Content – provided by child templates
      tr
        td.email-body
          block content

      //- Footer
      tr
        td.email-footer
          p &copy; #{new Date().getFullYear()} Starci Academy. All rights reserved.
          p
            a(href="https://academy.starci.org") academy.starci.org
