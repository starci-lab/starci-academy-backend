//- ─────────────────────────────────────────────────
//- Base layout for all StarCi Academy emails.
//- Clean, modern transactional style: white card,
//- wordmark header, generous whitespace, brand rose
//- accent (matches the web app token --accent, hue 354).
//- Child templates fill `block content`.
//- ─────────────────────────────────────────────────
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    style.
      /* Reset */
      body, table, td, p, a, h1, span { margin: 0; padding: 0; }
      body { width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
      img { border: 0; outline: none; text-decoration: none; }

      .email-bg {
        background-color: #f6f5f5;
        padding: 28px 16px;
        font-family: -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      }

      /* Card */
      .email-card {
        max-width: 520px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #ececec;
        border-radius: 16px;
        overflow: hidden;
      }

      /* Brand lockup */
      .email-brand {
        padding: 28px 36px 0;
      }
      .email-brand .brand-mark {
        width: 36px;
        height: 36px;
        vertical-align: middle;
      }
      .email-brand .brand-text {
        display: inline-block;
        margin-left: 10px;
        vertical-align: middle;
      }
      .email-brand .brand-name {
        display: block;
        font-size: 17px;
        font-weight: 700;
        color: #191818;
        letter-spacing: -0.2px;
        line-height: 1.1;
      }
      .email-brand .brand-tag {
        display: block;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 3px;
        color: #a3a1a2;
        line-height: 1.4;
      }

      /* Body */
      .email-body {
        padding: 26px 36px 36px;
        color: #737172;
        font-size: 15px;
        line-height: 1.65;
      }
      .email-body h1 {
        font-size: 22px;
        font-weight: 700;
        color: #191818;
        letter-spacing: -0.4px;
        margin-bottom: 10px;
      }
      .email-body p { margin-bottom: 16px; }
      .email-body .eyebrow {
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: #d73588;
        margin-bottom: 6px;
      }
      .email-body .muted { color: #a3a1a2; font-size: 13px; }
      .email-body .divider { height: 1px; background-color: #f0efef; margin: 28px 0; line-height: 1px; font-size: 0; }

      /* OTP cells */
      .otp-row { margin: 4px 0 14px; }
      .otp-cell {
        display: inline-block;
        width: 48px;
        padding: 16px 0;
        margin-right: 8px;
        text-align: center;
        background-color: #fff5f9;
        border: 1px solid #ffd9e8;
        border-radius: 12px;
        font-family: 'SF Mono', ui-monospace, 'Courier New', monospace;
        font-size: 26px;
        font-weight: 700;
        color: #99095c;
      }
      .otp-cell.last { margin-right: 0; }

      /* Button */
      .btn-primary {
        display: inline-block;
        padding: 13px 26px;
        background-color: #fb59a7;
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
      }

      /* Footer (outside the card) */
      .email-footer {
        max-width: 520px;
        margin: 14px auto 0;
        text-align: center;
        font-size: 12px;
        color: #b3b1b2;
      }
      .email-footer a { color: #d73588; text-decoration: none; }

  body(style="margin:0;")
    .email-bg
      .email-card
        .email-brand
          img.brand-mark(src="https://academy.starci.org/logo-icon.png" alt="StarCi Academy" width="36" height="36")
          span.brand-text
            span.brand-name StarCi
            span.brand-tag academy
        .email-body
          block content
      .email-footer
        | &copy; #{new Date().getFullYear()} StarCi Academy &middot;
        |
        a(href="https://academy.starci.org") academy.starci.org
