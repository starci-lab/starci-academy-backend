extends layouts/base

block content
  - var vi = locale === 'vi'
  p.eyebrow= vi ? 'Đã chấm AI Lab' : 'AI Lab graded'
  h1= vi ? 'Bài AI Lab của bạn đã được chấm' : 'Your AI Lab eval was graded'
  p= vi ? `Chào ${name}, bài eval prompt của bạn vừa được chấm xong.` : `Hi ${name}, your prompt eval has finished grading.`

  //- Score panel
  div(style="padding:20px 22px; background-color:#effcf5; border:1px solid #c8f0db; border-radius:14px; margin-bottom:24px;")
    p(style="font-size:13px; color:#6b7280; margin-bottom:6px;")= vi ? 'Điểm' : 'Score'
    span(style="font-size:40px; font-weight:800; color:#006d3b; line-height:1;")= totalScore
    span(style="font-size:16px; font-weight:500; color:#9bbcab; margin-left:6px;") / #{maxScore}
    if passed
      span(style="float:right; margin-top:10px; font-size:13px; font-weight:600; color:#006d3b; background:#d1fae5; padding:5px 12px; border-radius:999px;")= vi ? 'Đạt' : 'Passed'

  a.btn-primary(href=dashboardUrl)= vi ? 'Mở AI Lab →' : 'Open AI Lab →'
