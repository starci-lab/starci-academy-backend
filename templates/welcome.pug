extends layouts/base

block content
  p.eyebrow Welcome aboard
  h1 You’re all set, #{name}
  p Your account is ready. Jump into courses and challenges, and start levelling up your skills today.
  p(style="margin-bottom:28px;") We’re glad to have you with us.
  a.btn-primary(href=loginUrl) Get started →
  .divider
  p.muted(style="margin-bottom:0;") Didn’t sign up for StarCi Academy? You can safely ignore this email.
