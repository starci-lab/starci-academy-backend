extends layouts/base

block content
  - var vi = locale === 'vi'
  p.eyebrow= vi ? 'Tổng hợp hằng ngày' : 'Daily digest'
  h1= vi ? `Bạn có ${total} hoạt động mới` : `You have ${total} new updates`
  p= vi ? `Chào ${name}, đây là những gì đã diễn ra trong 24 giờ qua.` : `Hi ${name}, here’s what happened in the last 24 hours.`

  div(style="margin:0 0 24px; padding:4px 0;")
    if followers
      div(style="padding:12px 0; border-bottom:1px solid #f0efef; font-size:15px; color:#3f3d3e;")
        span(style="font-weight:700; color:#99095c;")= followers
        |
        | #{vi ? 'người theo dõi mới' : (followers > 1 ? 'new followers' : 'new follower')}
    if replies
      div(style="padding:12px 0; border-bottom:1px solid #f0efef; font-size:15px; color:#3f3d3e;")
        span(style="font-weight:700; color:#99095c;")= replies
        |
        | #{vi ? 'phản hồi tới bạn' : (replies > 1 ? 'replies to you' : 'reply to you')}

  a.btn-primary(href=dashboardUrl)= vi ? 'Xem chi tiết →' : 'See what’s new →'

  if settingsUrl
    p(style="margin-top:28px; font-size:12px; color:#b3b1b2;")
      | #{vi ? 'Không muốn nhận email tổng hợp? ' : 'Don’t want these digests? '}
      a(href=settingsUrl style="color:#d73588; text-decoration:underline;")= vi ? 'Tắt tại đây' : 'Turn them off'
