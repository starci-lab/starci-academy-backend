extends layouts/base

block content
  h1 Reset your password
  p Enter this code to confirm the password reset on your account.
  .otp-row
    - var digits = String(otp).split('')
    each d, i in digits
      span.otp-cell(class=(i === digits.length - 1 ? 'last' : ''))= d
  p.muted(style="margin-bottom:0;") This code expires in #{expiresInMinutes} minutes.
  .divider
  p.muted(style="margin-bottom:0;") Didn’t ask to reset your password? Ignore this email and your password stays unchanged.
