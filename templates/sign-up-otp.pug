doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Sign up OTP
  body(style="font-family: Arial, sans-serif; color: #111; line-height: 1.5;")
    h2(style="margin: 0 0 12px;") Verify your email
    p(style="margin: 0 0 12px;") Use the OTP below to complete your sign up:
    div(style="font-size: 28px; font-weight: 700; letter-spacing: 4px; padding: 12px 16px; border: 1px solid #ddd; display: inline-block;")
      | #{otp}
    p(style="margin: 12px 0 0;") This code expires in #{expiresInMinutes} minute(s).

