extends layouts/base

block content
  - var vi = locale === 'vi'
  p.eyebrow= vi ? 'Gói AI đã kích hoạt' : 'AI plan active'
  h1= vi ? 'Gói AI của bạn đã sẵn sàng' : 'Your AI plan is ready'
  p= vi ? `Chào ${name}, thanh toán đã thành công và gói AI của bạn đã được kích hoạt. Tận hưởng hạn mức cao hơn và các model premium nhé!` : `Hi ${name}, your payment went through and your AI plan is now active. Enjoy the higher limits and premium models!`
  if tier
    div(style="margin:0 0 24px; padding:14px 18px; background:#fff5f9; border:1px solid #ffd9e8; border-radius:12px; font-size:14px; color:#99095c;")
      | #{vi ? 'Gói' : 'Plan'}:
      |
      strong= tier
  a.btn-primary(href=dashboardUrl)= vi ? 'Dùng AI ngay →' : 'Start using AI →'
