extends layouts/base

block content
  - var vi = locale === 'vi'
  p.eyebrow= vi ? 'Bảo mật tài khoản' : 'Account security'
  h1= vi ? 'Mật khẩu của bạn đã được thay đổi' : 'Your password was changed'
  p= vi ? `Chào ${name}, mật khẩu tài khoản StarCi Academy của bạn vừa được thay đổi thành công.` : `Hi ${name}, the password for your StarCi Academy account was just changed successfully.`
  div(style="margin:0 0 28px; padding:14px 18px; background:#fff5f9; border:1px solid #ffd9e8; border-radius:12px; font-size:14px; color:#99095c;")
    | #{vi ? 'Không phải bạn? Hãy đặt lại mật khẩu ngay và liên hệ với chúng tôi.' : 'Not you? Reset your password immediately and contact us.'}
  a.btn-primary(href=dashboardUrl)= vi ? 'Vào tài khoản →' : 'Go to your account →'
