{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "../../..",
  "testEnvironment": "node",
  "testRegex": "\\.harness-spec\\.ts$",
  "roots": [
    "<rootDir>/src/tests/harness"
  ],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "diagnostics": false
      }
    ]
  },
  "transformIgnorePatterns": [],
  "moduleNameMapper": {
    "^@modules/(.*)$": [
      "<rootDir>/src/modules/$1",
      "<rootDir>/src/modules/lib/$1",
      "<rootDir>/src/modules/platform/$1",
      "<rootDir>/src/modules/integrations/$1"
    ],
    "^@features/(.*)$": "<rootDir>/src/features/$1",
    "^@tests/(.*)$": "<rootDir>/src/tests/$1"
  },
  "globalSetup": "<rootDir>/src/tests/helpers/harness-setup.ts",
  "globalTeardown": "<rootDir>/src/tests/helpers/harness-teardown.ts",
  "testTimeout": 1800000,
  "maxWorkers": 1
}
