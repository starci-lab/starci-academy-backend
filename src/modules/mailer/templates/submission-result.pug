extends layouts/base

block content
  h2(style="font-size: 20px; font-weight: 600; margin-bottom: 16px; color: #111827;") Submission Result: #{challengeTitle}
  p Hi <strong>#{name}</strong>,
  p Your submission for <strong>#{challengeTitle}</strong> has been graded.

  //- Score badge
  div(style="margin: 20px 0; padding: 16px; background-color: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; text-align: center;")
    p(style="font-size: 13px; color: #6b7280; margin-bottom: 4px;") Your Score
    p(style="font-size: 36px; font-weight: 700; color: #16a34a;") #{score}
      span(style="font-size: 16px; font-weight: 400; color: #9ca3af;") /100

  //- Feedback
  if feedback
    div(style="margin: 20px 0; padding: 16px; background-color: #f9fafb; border-left: 4px solid #6366f1; border-radius: 4px;")
      p(style="font-size: 13px; font-weight: 600; color: #6366f1; margin-bottom: 8px;") Feedback
      p(style="white-space: pre-wrap;") #{feedback}

  p(style="text-align: center;")
    a.btn-primary(href=dashboardUrl) View Dashboard

  p(style="margin-top: 24px; color: #6b7280; font-size: 13px;") Keep up the great work! 🚀
