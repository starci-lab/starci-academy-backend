extends layouts/base

block content
  h2(style="font-size: 20px; font-weight: 600; margin-bottom: 16px; color: #111827;") Welcome, #{name}! 🎉
  p We're thrilled to have you join <strong>Starci Academy</strong>.
  p Your account is ready. Start exploring courses, challenges, and level up your skills right away.
  p(style="text-align: center;")
    a.btn-primary(href=loginUrl) Get Started
  p(style="margin-top: 24px; color: #6b7280; font-size: 13px;") If you did not sign up, you can safely ignore this email.
