# Cổng HTTP cho NestJS (EN: HTTP port for NestJS)
PORT=3002

# PostgreSQL master (primary) — ghi (EN: PostgreSQL master (primary) — writes)
POSTGRES_MASTER_HOST=localhost
POSTGRES_MASTER_PORT=5432

# PostgreSQL replica (slave) — đọc (EN: PostgreSQL replica (slave) — reads)
POSTGRES_REPLICA_HOST=localhost
POSTGRES_REPLICA_PORT=5433

# Thông tin xác thực chung (EN: Shared credentials)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your_postgres_password>
POSTGRES_DB=orders_db
