{
  "mcpServers": {
    "starci-code": {
      "command": "npx",
      "args": ["-y", "@mhalder/qdrant-mcp-server"],
      "env": {
        "QDRANT_URL": "http://localhost:6360",
        "QDRANT_API_KEY": "starci-code-local",
        "EMBEDDING_PROVIDER": "ollama",
        "EMBEDDING_BASE_URL": "http://localhost:11434",
        "EMBEDDING_MODEL": "bge-m3",
        "EMBEDDING_DIMENSIONS": "1024",
        "CODE_ENABLE_AST": "true",
        "CODE_ENABLE_HYBRID": "true",
        "LOG_LEVEL": "info"
      }
    }
  }
}
