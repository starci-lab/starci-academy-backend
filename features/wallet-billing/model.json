  "scope": {
    "includes": [
      "Wallet balance",
      "Wallet transaction ledger",
      "Invoice ledger",
      "Paying an unpaid invoice and starting linked provisioning"
    ],
    "excludes": [
      "A wired wallet top-up flow",
      "Invented ledger totals"
    ]
  },
