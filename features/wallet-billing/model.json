      "trigger": "Open Wallet",
      "steps": [
        {
          "id": "step-1",
          "actor": "account-actor",
          "action": "Open Wallet",
          "result": "Review balance, transactions and invoices",
          "surfaceId": "wallet",
          "stateId": "resting"
        },
        {
          "id": "step-2",
          "actor": "account-actor",
          "action": "Review balance, transactions and invoices",
          "result": "Pay the newest unpaid invoice",
          "surfaceId": "wallet",
          "stateId": "empty"
        },
        {
          "id": "step-3",
          "actor": "account-actor",
          "action": "Pay the newest unpaid invoice",
          "result": "Refresh money and service-fulfillment facts",
          "surfaceId": "wallet",
          "stateId": "answered"
        },
        {
          "id": "step-4",
          "actor": "account-actor",
          "action": "Refresh money and service-fulfillment facts",
          "result": "The invoice becomes paid and linked provisioning starts",
          "surfaceId": "wallet",
          "stateId": "refused"
        }
      ],
      "outcomes": [
        "The invoice becomes paid and linked provisioning starts",
        "Each ledger retains its own resting, empty, answered or refused state"
      ],
