  "acceptance": [
    {
      "id": "AC-01",
      "statement": "After AgentOS is ready, a user can choose one registered kind and land on management for the created draft module.",
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-004"
      ]
    },
    {
      "id": "AC-02",
      "statement": "Management always shows Overview, Shared chat, kind workbench and Readiness areas.",
      "evidenceIds": [
        "EV-004"
      ]
    },
    {
      "id": "AC-03",
      "statement": "Two different kinds reuse the same module shell and chat while rendering different workbench contracts.",
      "evidenceIds": [
        "EV-003",
        "EV-004"
      ]
    },
    {
      "id": "AC-04",
      "statement": "A newly registered kind is selectable without modifying shared chat or the module shell.",
      "evidenceIds": [
        "EV-003",
        "EV-004"
      ]
    },
    {
      "id": "AC-05",
      "statement": "Activation fails with specific missing-setting feedback until all required configuration validates.",
      "evidenceIds": [
        "EV-004"
      ]
    },
    {
      "id": "AC-06",
      "statement": "Changing a module kind is not offered; the user creates a new module instead.",
      "evidenceIds": [
        "EV-004"
      ]
    }
  ],
  "unknowns": [
    {
      "id": "shared-chat-cardinality",
      "question": "Does shared chat contain one conversation or multiple threads per module?",
      "impact": "The shared chat capability is approved but its conversation or mailbox cardinality remains undefined."
    },
    {
      "id": "module-permissions",
      "question": "Which roles and sharing granularity apply to module management and use?",
      "impact": "The exact permission and collaboration policy remains undefined."
    },
    {
      "id": "workbench-integration-mode",
      "question": "Is each workbench embedded, linked or implemented natively?",
      "impact": "Examples establish purpose but not provider or integration technology."
    },
    {
      "id": "kind-specific-schema",
      "question": "Which fields and credentials are required by each registered kind?",
      "impact": "The registry contract is approved while each concrete kind schema remains separately owned."
    },
    {
      "id": "extended-lifecycle",
      "question": "What are the archive, delete, duplicate and import or export rules?",
      "impact": "The approved lifecycle closes at activation."
    }
  ],
