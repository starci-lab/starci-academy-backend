  "project": "starci-academy",
  "featureId": "agentos-module-management",
  "title": "AgentOS post-install module creation and management",
  "summary": "After AgentOS is installed and ready, an end user creates a module by choosing one extensible kind, configures the common module and shared chat plus one kind-specific workbench, validates readiness, and activates the module.",
  "sources": [
    {
      "role": "fe",
      "repository": "https://github.com/starci-lab/starci-academy-fe.git",
      "head": "f14e3c24b4a087fb6d4bb09d73526964d3ecea3c"
    },
    {
      "role": "be",
      "repository": "https://github.com/starci-lab/starci-academy-backend",
      "head": "eeeaef30b60b823eb894fed410cc6742ed0bd08f"
    }
  ],
  "scope": {
    "includes": [
      "Post-install module creation",
      "Module kind selection",
      "Module management",
      "Shared chat configuration",
      "Kind-specific workbench configuration",
      "Readiness validation and activation"
    ],
    "excludes": [
      "Course learning",
      "Frontend layout implementation",
      "Database inheritance strategy",
      "Specific Excel or Calendar embedding technology",
      "Deployment"
    ]
  },
  "actors": [
    {
      "id": "agentos-user",
      "label": "AgentOS user",
      "capabilities": [
        "Create a module after AgentOS is ready",
        "Choose one registered module kind",
        "Configure common module settings and shared chat",
        "Configure the kind-specific workbench",
        "Validate readiness and activate a module"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-004"
      ]
    },
    {
      "id": "agentos-platform",
      "label": "AgentOS platform",
      "capabilities": [
        "List registered module kinds",
        "Create draft modules",
        "Mount shared chat for every module",
        "Resolve one kind-specific workbench",
        "Validate readiness and gate activation"
      ],
      "evidenceIds": [
        "EV-003",
        "EV-004"
      ]
    }
  ],
  "flows": [
    {
      "id": "post-install-module-setup",
      "title": "Create, configure and activate an AgentOS module",
      "trigger": "AgentOS reaches the installed-ready state and the user starts module creation.",
      "steps": [
        {
          "id": "choose-module-kind",
          "actor": "agentos-user",
          "action": "Choose exactly one kind from the registered kind catalog",
          "result": "The selected kind is bound to a new draft module",
          "surfaceId": "module-kind-selection",
          "stateId": "module-draft"
        },
        {
          "id": "configure-module",
          "actor": "agentos-user",
          "action": "Configure Overview, Shared chat and the selected kind workbench",
          "result": "Common, chat and kind-owned settings are saved on the draft module",
          "surfaceId": "module-management",
          "stateId": "module-draft"
        },
        {
          "id": "validate-readiness",
          "actor": "agentos-user",
          "action": "Run readiness validation",
          "result": "The module becomes ready or shows actionable missing-setting evidence",
          "surfaceId": "module-management",
          "stateId": "module-ready"
        },
        {
          "id": "activate-module",
          "actor": "agentos-user",
          "action": "Activate a ready module",
          "result": "The module becomes available in the AgentOS user workspace",
          "surfaceId": "module-management",
          "stateId": "module-active"
        }
      ],
      "outcomes": [
        "The user obtains an active module with shared chat and one workbench selected by its kind"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-004"
      ]
    }
  ],
  "rules": [
    {
      "id": "BR-01",
      "statement": "The UI may label the discriminator Type; durable domain authority names it kind.",
      "strength": "owner-approved",
      "evidenceIds": [
        "EV-004"
      ]
    },
    {
      "id": "BR-02",
      "statement": "A module has exactly one kind selected from an extensible registry, never a closed product enum.",
      "strength": "owner-approved",
      "evidenceIds": [
        "EV-003",
        "EV-004"
      ]
    },
    {
      "id": "BR-03",
      "statement": "Kind is selected before the draft module is created and is immutable for that module; changing kind requires creating another module.",
      "strength": "owner-approved",
      "evidenceIds": [
        "EV-004"
      ]
    },
    {
      "id": "BR-04",
      "statement": "Every module exposes the same shared chat capability regardless of kind.",
      "strength": "owner-approved",
      "evidenceIds": [
        "EV-003",
        "EV-004"
      ]
    },
    {
      "id": "BR-05",
      "statement": "Each kind resolves exactly one additional workbench contract; adding a kind registers a new contract without changing the module shell or shared chat.",
      "strength": "owner-approved",
      "evidenceIds": [
        "EV-003",
        "EV-004"
      ]
    },
    {
      "id": "BR-06",
      "statement": "The management page separates common module settings, shared-chat settings and kind-owned workbench settings.",
      "strength": "owner-approved",
      "evidenceIds": [
        "EV-001",
        "EV-004"
      ]
    },
    {
      "id": "BR-07",
      "statement": "A module remains draft until all required common, chat and kind-owned settings pass readiness validation.",
      "strength": "owner-approved",
      "evidenceIds": [
        "EV-004"
      ]
    },
    {
      "id": "BR-08",
      "statement": "Activation is rejected with actionable missing-setting evidence when readiness fails.",
      "strength": "owner-approved",
      "evidenceIds": [
        "EV-004"
      ]
    },
    {
      "id": "BR-09",
      "statement": "Excel, Calendar, Document, Accounting and Scheduling are examples of workbenches, not hard-coded kinds or integration modes.",
      "strength": "owner-approved",
      "evidenceIds": [
        "EV-003",
        "EV-004"
      ]
    }
  ],
