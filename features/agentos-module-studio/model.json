{
  "schemaVersion": 2,
  "authority": {
    "status": "pending",
    "basis": "owner-intent",
    "requiredRoles": [
      "fe",
      "be"
    ]
  },
  "project": "nivo",
  "featureId": "agentos-module-studio",
  "title": "AgentOS custom module studio",
  "summary": "An authenticated owner creates and manages workspace-owned custom module drafts through a resumable adaptive interview, supplies scanned supporting files and write-only integration secrets, reviews a backend-owned completeness profile and explicitly publishes a versioned module specification into the existing AgentOS installation lifecycle.",
  "sources": [
    {
      "role": "fe",
      "repository": "https://github.com/starci-lab/nivo-fe.git",
      "head": "894e608bba73d791e5d2767cdc420da770c8c42b"
    },
    {
      "role": "be",
      "repository": "https://github.com/starci-lab/nivo-backend.git",
      "head": "ac05d90e7b6b59eb9dc4128872f3c02ba254e59a"
    }
  ],
  "scope": {
    "includes": [
      "Custom-module management nested under one exact ready AgentOS workspace",
      "Pre-persistence module creation followed by a persistent resumable module studio",
      "Backend-owned adaptive follow-up questions, structured module profile, missing fields, progress and completion",
      "Quarantined image and document attachment intake with scan, retry and removal states",
      "Write-only encrypted named integration-secret intake with masked configuration status",
      "Versioned reviewable module specification and an explicit publish or install transition"
    ],
    "excludes": [
      "Changing the existing immutable solution-module catalogue, catalogue install mutation or installation-detail route",
      "Changing AgentOS order, Wallet payment, workspace provisioning or readiness semantics",
      "Returning, rendering or logging secret values, storage credentials, scanner internals or raw control-plane access",
      "Publishing or installing a module automatically when a chat turn completes",
      "Importing TEDO product content, pricing, artifacts, actors or business rules"
    ]
  },
  "actors": [
    {
      "id": "workspace-owner",
      "label": "Authenticated owner of one exact ready AgentOS workspace",
      "capabilities": [
        "Browse workspace-owned custom module drafts and published modules",
        "Start and resume an adaptive module interview",
        "Answer, correct and extend module requirements",
        "Attach supporting images and documents",
        "Configure or remove named integration secrets without reading them back",
        "Review completeness and explicitly publish or install a ready specification"
      ],
      "evidenceIds": [
        "EV-001"
      ]
    }
  ],
  "flows": [
    {
      "id": "create-and-complete-module",
      "title": "Create a custom module through adaptive follow-up questions",
      "trigger": "The workspace owner chooses Create module from the exact workspace module collection.",
      "steps": [
        {
          "id": "open-module-create",
          "actor": "workspace-owner",
          "action": "Open the separate module-create route without creating a blank persisted module",
          "result": "The owner sees the first assistant prompt and a composer scoped to the exact workspace",
          "surfaceId": "module-create",
          "stateId": "intake-resting"
        },
        {
          "id": "submit-opening-answer",
          "actor": "workspace-owner",
          "action": "Submit the opening module goal",
          "result": "The backend creates one idempotent custom-module draft and intake session, then returns the exact persistent studio identity",
          "surfaceId": "module-create",
          "stateId": "intake-submitting"
        },
        {
          "id": "answer-adaptive-question",
          "actor": "workspace-owner",
          "action": "Answer the current backend-selected question or correct a prior answer",
          "result": "The answer is persisted, the structured profile and missing fields are recomputed, and the next unresolved question is returned",
          "surfaceId": "module-studio",
          "stateId": "intake-awaiting-answer"
        },
        {
          "id": "supply-module-resources",
          "actor": "workspace-owner",
          "action": "Attach relevant images or documents and configure required integration keys",
          "result": "Only scan-ready attachments and masked configured-secret statuses contribute to module readiness",
          "surfaceId": "module-studio",
          "stateId": "intake-incomplete"
        },
        {
          "id": "reach-module-completeness",
          "actor": "workspace-owner",
          "action": "Resolve every backend-declared missing field",
          "result": "The backend marks the intake complete and generates a versioned reviewable module specification",
          "surfaceId": "module-studio",
          "stateId": "specification-ready"
        }
      ],
      "outcomes": [
        "One exact workspace-owned draft and intake session remain resumable",
        "The owner reaches a reviewable specification only after backend-owned completion"
      ],
      "evidenceIds": [
        "EV-001"
      ]
    },
    {
      "id": "resume-and-manage-module",
      "title": "Resume or manage one exact custom module",
      "trigger": "The workspace owner selects a draft or published custom module from the module collection.",
      "steps": [
        {
          "id": "choose-owned-module",
          "actor": "workspace-owner",
          "action": "Choose one module belonging to the exact workspace",
          "result": "The route preserves workspaceId and moduleId and refuses a foreign or absent module",
          "surfaceId": "module-management",
          "stateId": "module-collection-ready"
        },
        {
          "id": "restore-module-studio",
          "actor": "workspace-owner",
          "action": "Open the module studio",
          "result": "Conversation, structured profile, missing fields, attachments, masked secret statuses and current specification are restored",
          "surfaceId": "module-studio",
          "stateId": "intake-awaiting-answer"
        },
        {
          "id": "continue-module-management",
          "actor": "workspace-owner",
          "action": "Continue the interview or update an allowed resource",
          "result": "The backend recomputes readiness without losing previously accepted information",
          "surfaceId": "module-studio",
          "stateId": "intake-incomplete"
        }
      ],
      "outcomes": [
        "Interrupted intake resumes without creating a duplicate draft",
        "The owner can distinguish incomplete, ready-for-review, publishing, active and refused modules"
      ],
      "evidenceIds": [
        "EV-001"
      ]
    },
    {
      "id": "review-and-publish-module",
      "title": "Review and explicitly publish one complete custom module",
      "trigger": "The backend has generated a complete versioned module specification.",
      "steps": [
        {
          "id": "review-module-specification",
          "actor": "workspace-owner",
          "action": "Review the generated specification, its source attachments and masked integration requirements",
          "result": "The owner can return to the interview or proceed with the exact specification version",
          "surfaceId": "module-studio",
          "stateId": "specification-ready"
        },
        {
          "id": "confirm-module-publish",
          "actor": "workspace-owner",
          "action": "Explicitly confirm Publish or Install with an idempotency identity",
          "result": "The backend accepts one asynchronous publish operation and never treats chat completion as consent",
          "surfaceId": "module-studio",
          "stateId": "module-publishing"
        },
        {
          "id": "observe-module-publish-result",
          "actor": "workspace-owner",
          "action": "Observe the publish result",
          "result": "Success returns the existing installation identity; refusal preserves the reviewable specification and exposes a safe retry",
          "surfaceId": "module-studio",
          "stateId": "module-active"
        }
      ],
      "outcomes": [
        "A complete custom specification enters the existing installation lifecycle only through explicit owner confirmation",
        "The existing owner-scoped installation-detail route remains the terminal runtime inspection surface"
      ],
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-004",
        "EV-006",
        "EV-008"
      ]
    }
  ],
  "rules": [
    {
      "id": "BR-01",
      "statement": "Every custom module, intake session, attachment, configured-secret status and generated specification belongs to one exact authenticated owner and one exact ready AgentOS workspace.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-010"
      ]
    },
    {
      "id": "BR-02",
      "statement": "The backend owns required fields, the next follow-up question, structured profile, missing fields, progress and completion; the frontend renders those results and never invents readiness.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001"
      ]
    },
    {
      "id": "BR-03",
      "statement": "Each accepted answer or correction is persisted before the next question is selected, and a changed answer may change every later unresolved question.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001"
      ]
    },
    {
      "id": "BR-04",
      "statement": "A custom-module draft is resumable after navigation, reload or a local operation failure without duplicating the draft or discarding previously accepted information.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001"
      ]
    },
    {
      "id": "BR-05",
      "statement": "Integration key values are write-only, encrypted server-side and never returned, rendered, placed in conversation text or logged; clients receive only masked configuration status.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001"
      ]
    },
    {
      "id": "BR-06",
      "statement": "An image or document attachment contributes to the module profile only after quarantine and successful scanning; uploading, scanning, ready, refused, retry and removal remain explicit states.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001"
      ]
    },
    {
      "id": "BR-07",
      "statement": "Conversation completion generates a reviewable versioned specification but never publishes or installs a module without a separate explicit owner confirmation.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001"
      ]
    },
    {
      "id": "BR-08",
      "statement": "Custom-module drafts and their studio do not replace or mutate the existing immutable solution-module catalogue, catalogue installation operation or installation-detail identity.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001",
        "EV-002",
        "EV-003",
        "EV-004",
        "EV-005",
        "EV-006",
        "EV-007",
        "EV-008",
        "EV-009",
        "EV-010"
      ]
    },
    {
      "id": "BR-09",
      "statement": "Interview, attachment, secret and publish failures are independent block-state axes; a refusal preserves every other previously accepted part of the module profile.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001"
      ]
    },
    {
      "id": "BR-10",
      "statement": "The TEDO page contributes interaction shape only; none of its project content, prices, artifact promises, actors or business rules becomes Nivo product truth.",
      "strength": "confirmed",
      "evidenceIds": [
        "EV-001"
      ]
    }
  ],
