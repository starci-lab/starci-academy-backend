{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "../../..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "roots": [
    "<rootDir>/apps/core/test"
  ],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "diagnostics": false
      }
    ]
  },
  "transformIgnorePatterns": [],
  "moduleNameMapper": {
    "^@modules/(.*)$": [
      "<rootDir>/src/modules/$1",
      "<rootDir>/src/modules/lib/$1",
      "<rootDir>/src/modules/platform/$1",
      "<rootDir>/src/modules/integrations/$1"
    ],
    "^@features/(.*)$": "<rootDir>/src/features/$1"
  },
  "globalSetup": "<rootDir>/apps/core/test/setup-e2e.ts",
  "globalTeardown": "<rootDir>/apps/core/test/teardown-e2e.ts",
  "testTimeout": 120000,
  "maxWorkers": 1
}
